# class: open-redirect
# lang: ts
# role: sink
# band: 1
# version: 1
# append-only: 变更须经 CALIBRATION 人工批准（B-115）——批准行只增不删
#---
pattern_id	ere	note
OR-T01	res\.redirect\(	express 状态跳转第一锚
OR-T02	\.redirect\(	通用/框架跳转点(含 res.redirect 前缀,归属保留)
OR-T03	window\.location.*=	客户端跳转赋值(href/hash/search 全形)
OR-T04	document\.location.*=	document 侧客户端跳转
OR-T05	location\.href[[:space:]]*=	href 精确赋值形态(含 window. 前缀重叠)
OR-T06	location\.assign\(	导航 API 形态
OR-T07	location\.replace\(	替换导航(不留历史,同向量)
OR-T08	NextResponse\.redirect\(	next.js 服务端跳转(callback 路由高发)
OR-T09	router\.push\(	SPA 客户端导航(次级向量,常量目标 noise 高发)
OR-T10	set\(["']Location	响应头直写形式(headers.set/append)
