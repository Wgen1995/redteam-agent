# class: secrets-crypto
# lang: ts
# role: sink
# band: 1
# version: 1
# append-only: 变更须经 CALIBRATION 人工批准（B-115）——批准行只增不删
#---
pattern_id	ere	note
SC-T01	AKIA[A-Z0-9]{16}	AWS Access Key ID 形态（CWE-798）
SC-T02	-----BEGIN.*PRIVATE KEY-----	PEM 私钥块内嵌源码（CWE-798）
SC-T03	password[[:space:]]*[:=][[:space:]]*["']	硬编码口令（对象字面量/赋值）
SC-T04	apiKey[[:space:]]*[:=][[:space:]]*["']	硬编码 apiKey（对象字面量/赋值）
SC-T05	secret[[:space:]]*[:=][[:space:]]*["']	硬编码 secret（对象字面量/赋值）
SC-T06	mongodb([+]srv)?:.*@	连接 URI 内嵌凭据（CWE-798）
SC-T07	createHash\(.*md5	node crypto MD5 摘要（CWE-327）
SC-T08	createCipher\(	node crypto 弃用 createCipher（可预测 IV，CWE-327 家族标记）
SC-T09	Math\.random\(	弱随机（CWE-330/327）
