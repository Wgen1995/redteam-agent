pattern_id	ere	note
CI-P01	os\.system\(
CI-P02	os\.popen\(
CI-P03	subprocess\.run\(.*shell[[:space:]]*=[[:space:]]*True	字符串命令+shell=True 形态
CI-P04	subprocess\.call\(.*shell[[:space:]]*=[[:space:]]*True
CI-P05	subprocess\.check_output\(.*shell[[:space:]]*=[[:space:]]*True
CI-P06	subprocess\.check_call\(.*shell[[:space:]]*=[[:space:]]*True
CI-P07	subprocess\.Popen\(.*shell[[:space:]]*=[[:space:]]*True
CI-P08	subprocess\.getoutput\(	隐式 shell 形态
CI-P09	import subprocess	模块导入家族标记
CI-P10	from subprocess import	直连导入家族标记
CI-P11	shell[[:space:]]*=[[:space:]]*True	shell=True 字面家族标记（直连导入形态兜底）
CI-P12	(^|[[:space:](=,])eval\(	bare eval（点前缀 model.eval 形态排除）
