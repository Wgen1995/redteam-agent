# class: secrets-crypto
# lang: java
# role: sink
# band: 1
# version: 1
# append-only: 变更须经 CALIBRATION 人工批准（B-115）——批准行只增不删
#---
pattern_id	ere	note
SC-J01	AKIA[A-Z0-9]{16}	AWS Access Key ID 形态（CWE-798，gitleaks aws-access-token 族）
SC-J02	-----BEGIN.*PRIVATE KEY-----	PEM 私钥块内嵌源码（CWE-798）
SC-J03	password[[:space:]]*=[[:space:]]*"	硬编码口令赋值（连接串/Properties/字符串字面）
SC-J04	PASSWORD[[:space:]]*=[[:space:]]*"	大写常量形态
SC-J05	secret[[:space:]]*=[[:space:]]*"	硬编码 secret 赋值
SC-J06	api_key[[:space:]]*=[[:space:]]*"	硬编码 api key 赋值
SC-J07	jdbc:.*password=	连接串内嵌口令（CWE-798）
SC-J08	MessageDigest\.getInstance\(.*"MD5	MD5 摘要（CWE-327）
SC-J09	MessageDigest\.getInstance\(.*"SHA-1	SHA-1 摘要（CWE-327）
SC-J10	Cipher\.getInstance\(.*"DES	DES/DESede 分组密码（CWE-327）
SC-J11	Cipher\.getInstance\(.*ECB	ECB 模式（CWE-327，同文重复模式泄露）
SC-J12	KeyGenerator\.getInstance\(.*"DES	DES 密钥生成（CWE-327）
SC-J13	DigestUtils\.md5	commons-codec MD5 家族（md5/md5Hex）
SC-J14	new Random\(	弱随机（java.util.Random；密码学语境由五步判别）
