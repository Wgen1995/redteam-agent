    %% ────────── Phase 5 攻击链构建 ──────────
    subgraph P5["Phase 5 攻击链构建"]
        direction TB
        all_atk("edges/attack.json (所有 ATK-CAND)"):::signal
        step5_1("1. 读取攻击候选池: 所有来源的 ATK-CAND"):::step
        step5_2("2. 识别链起点: 独立可达的攻击"):::step
