#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-install · 六步安装器（批次 6 T5；退出码 0=通过/1=门禁失败/2=环境问题）。

判定命令（出口 #6）：py -3 cli/tanyin-install --home <tmp> --timestamp <TS> 连跑两次
（幂等零变更）+ py -3 cli/tanyin-selfcheck --static 六项全 PASS。"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger import install_core  # noqa: E402


def _refresh_cve_cli(rest):
    """G-32 refresh-cve 子命令（批次 6 T9；显式人工刷新通道，非定时自动）。"""
    ap = argparse.ArgumentParser(prog="tanyin-install refresh-cve")
    ap.add_argument("--from", dest="src", required=True,
                    help="快照源：URL 或 file:// 本地路径（离线等价通道）")
    ap.add_argument("--home", default=install_core.DEFAULT_HOME_expanded(),
                    help="交战区 home（知识库=<home>/knowledge；缺省 ~/.tanyin）")
    ap.add_argument("--knowledge-dir", default=None,
                    help="缺省=<home>/knowledge")
    ap.add_argument("--timestamp", required=True,
                    help="显式 ISO8601（snapshot-date 注记+审计行；禁墙钟）")
    a = ap.parse_args(rest)
    kd = a.knowledge_dir or os.path.join(a.home, "knowledge")
    code, msg = install_core.refresh_cve(a.src, kd, a.timestamp)
    print(msg)
    return code


def main(argv):
    if argv and argv[0] == "refresh-cve":
        return _refresh_cve_cli(argv[1:])
    if argv and argv[0] == "uninstall":
        ap = argparse.ArgumentParser(prog="tanyin-install uninstall")
        ap.add_argument("--install-root", default=None, help="待移除权威安装树")
        ap.add_argument("--home", default=None, help="交战区 home（默认保留）")
        ap.add_argument("--purge-home", action="store_true",
                        help="显式销毁交战区 home（真实数据，慎用）")
        ap.add_argument("--timestamp", default=None, help="显式 ISO8601（必填）")
        a = ap.parse_args(argv[1:])
        if not a.timestamp:
            ap.error("--timestamp 必填（显式 ISO8601；禁墙钟进安装日志）")
        repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        o = {"install_root": a.install_root or install_core.DEFAULT_INSTALL_ROOT_expanded(),
             "home": a.home or install_core.DEFAULT_HOME_expanded(),
             "repo_root": repo_root, "timestamp": a.timestamp}
        rc, msg = install_core.uninstall(o, purge_home=a.purge_home)
        print(msg)
        return rc
    ap = argparse.ArgumentParser(prog="tanyin-install")
    ap.add_argument("--install-root", default=None,
                    help="权威安装树（缺省 ~/.local/share/tanyin）")
    ap.add_argument("--home", default=None, help="交战区 home（缺省 ~/.tanyin）")
    ap.add_argument("--host", default="dsh", help="宿主模板名（install/hosts/<host>.json）")
    ap.add_argument("--repo-root", default=None, help="缺省=脚本上级目录（仓根）")
    ap.add_argument("--pubkey", default=None, help="信任锚公钥（缺省 engines/nuclei/release.pub）")
    ap.add_argument("--timestamp", default=None, help="显式 ISO8601（禁墙钟进安装日志；安装路径必填）")
    ap.add_argument("--list-hosts", action="store_true",
                    help="打印五宿主模板 verification 字段（§10.3 发布口径）")
    ap.add_argument("--release", action="store_true",
                    help="信任锚替换通道（裁决 C；KEY-MANAGEMENT §4）：--pubkey "
                         "新锚公钥路径传入 verify 面替换 TEST-ONLY 缺省锚，交互确认后生效")
    a = ap.parse_args(argv)
    repo_root = a.repo_root or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if a.list_hosts:
        hdir = os.path.join(repo_root, "install", "hosts")
        for fn in sorted(os.listdir(hdir)):
            if not fn.endswith(".json"):
                continue
            with open(os.path.join(hdir, fn), encoding="utf-8") as f:
                t = json.load(f)
            print("%s\t%s\ttier=%s\thook=%s" % (
                t["host"], t["verification"], t["egress_default_tier"],
                "有" if t.get("hook_mechanism") else "无"))
        return 0
    if not a.timestamp:
        ap.error("--timestamp 必填（显式 ISO8601；禁墙钟进安装日志）")  # argparse 退出码 2
    opts = {"install_root": a.install_root or install_core.DEFAULT_INSTALL_ROOT_expanded(),
            "home": a.home or install_core.DEFAULT_HOME_expanded(),
            "host": a.host, "repo_root": repo_root,
            "pubkey": a.pubkey, "timestamp": a.timestamp}
    if a.release:
        # I-2（裁决 C 接线）：--release 信任锚替换通道（独立于六步安装；换锚后
        # 复跑六步安装即以新锚验签——KEY-MANAGEMENT §4 同步动作 ①整锁重签 ②指纹行）
        code, msg = install_core.release_anchor(opts)
        print(msg)
        return code
    code, msg = install_core.install(opts)
    print(msg)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
