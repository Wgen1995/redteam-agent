#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-ledger 单入口（批次 1）——41 命令面；当前实现：validate/verify-chain/next-id。
退出码：0=通过 1=门禁失败 2=环境问题（对齐 Strix）。"""
import sys, os
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "tests"))
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger import core

USAGE = "用法: tanyin-ledger <command> --goal-dir <dir> [参数]  (契约附录 A: contracts/02a)"

def main(argv):
    if len(argv) < 3 or not argv[1] or argv[2] != "--goal-dir" or len(argv) < 4:
        sys.stderr.write(USAGE + chr(10)); return 2
    cmd, goal_dir, rest = argv[1], argv[3], argv[4:]
    if not os.path.isdir(goal_dir):
        sys.stderr.write("环境问题: goal 目录不存在 " + goal_dir + chr(10)); return 2
    try:
        if cmd == "validate":
            return core.cmd_validate(goal_dir)
        if cmd == "verify-chain":
            return core.cmd_verify_chain(goal_dir)
        if cmd == "next-id":
            if len(rest) != 3:
                sys.stderr.write("用法: next-id --goal-dir D <table> <prefix> <goal-id>" + chr(10)); return 2
            return core.cmd_next_id(goal_dir, rest[0], rest[1], rest[2])
        sys.stderr.write("未实现/未知命令: " + cmd + chr(10) + USAGE + chr(10)); return 2
    except Exception as e:
        print("FAIL " + str(e)); return 1

if __name__ == "__main__":
    sys.exit(main(sys.argv))
