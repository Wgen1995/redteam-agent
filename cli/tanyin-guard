TAB = chr(9)
# 洞 1：scope 判定三态消息（契约 05）——exclude 优先于 include；oob=记不测。
SCOPE_REASON = {"exclude": "排除目标(exclude 优先于 include)",
                "oob": "OOB 回连端点(契约05 界外=记不测，非主动测试目标)",
                "out": "界外目标"}

def usage():
    sys.stderr.write("用法: tanyin-guard exec|inject|deploy-vault --goal-dir D ..." + chr(10))
    return 2

def tokenize_output(text, secrets):
    """vault 真值 -> {{vault:cred-N}} token（洞 3：stdout 与 stderr 双流同脱敏；
    长值优先替换，防短真值是长真值子串时遮蔽）。"""
    for n, s in secrets:
        if s:
            text = text.replace(s, "{{vault:cred-%s}}" % n)
    return text


def tokenize_argv(cmd, secrets):
    """full argv 脱敏铸造（OP2，02-opsec 缺口#3「request-ticket 只记 cmd[0]+argc
    ——full argv 不落账，流量画像不可重建」）——复用 tokenize_output 的 vault
    真值长值优先占位替换；timeline 事件列不在 special.py {{vault:}} 占位符白名单
    （creds.secret_ref/E-index.repro_command 冻结口径），占位形降格 <cred-N> 防
    redact-scan 误报泄漏；token 内 TAB/CRLF 清洗为空格防 TSV 列破格。"""
    line = " ".join(str(t).replace(chr(9), " ").replace(chr(13), " ").replace(chr(10), " ")
                    for t in cmd)
    line = tokenize_output(line, secrets)
    return re.sub(r"\{\{vault:cred-(\d+)\}\}", r"<cred-\1>", line)

# 批次 10 T5（P2#9）：timeline 铸造单源=ledger.timeline——本地复制退役，
# partial 绑定保既有调用点签名/行为不变（actor=guard, phase=P3）。
from functools import partial as _partial
from ledger.timeline import append_tl_locked as _append_tl_locked
