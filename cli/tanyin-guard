# vault 逻辑单源=ledger/vault.py（批4 T4 抽取，guard/replay 共用，行为零变更）；
# 此处同名 thin delegate 保既有调用点与命令输出字节不变。
def vault_dir(gd):
    return vault.vault_dir(gd)

def enc_payload(key, plaintext):
    return vault.enc_payload(key, plaintext)

def guard_key(gd):
    return vault.load_key(gd)

def read_cred(gd, n):
    return vault.read_cred(gd, n)

def vault_secrets(gd):
    return vault.secrets(gd)

def _read_secret_channel(kv, flag, env_name):
    """密值通道（批次 7 T10）：stdin 旗标显式 opt-in 读一行 > env 环境变量。
    无人值守上下文里隐式读 stdin=阻塞事故源，故 stdin 必须走旗标。"""
    if flag in kv:   # 裸旗标形（--secret-stdin 无值）也生效——kv 值为空串
        return sys.stdin.readline().rstrip()
    return os.environ.get(env_name)


def cmd_deploy_vault(gd, rest):
    kv = dict(a.partition("=")[::2] for a in rest if a.startswith("--"))
    # 批次 7 T10（High）：--secret/--passphrase 退出 argv（进程列表可读=密值暴露面）——
    # argv 出现即 usage exit 2（错误消息零回显）；密值改走 env/stdin 通道。
    if "--secret" in kv or "--passphrase" in kv:
        sys.stderr.write("用法错误: 密值不经 argv——用 TANYIN_VAULT_SECRET/"
                         "TANYIN_VAULT_PASSPHRASE 环境通道或 --secret-stdin/"
                         "--passphrase-stdin 旗标" + chr(10))
        return 2
    for need in ("--cred", "--username"):
        if not kv.get(need):
            sys.stderr.write("deploy-vault 缺 " + need + chr(10))
            return 2
    secret = _read_secret_channel(kv, "--secret-stdin", "TANYIN_VAULT_SECRET")
    if not secret:
        sys.stderr.write("deploy-vault 缺密值（TANYIN_VAULT_SECRET 或 --secret-stdin）" + chr(10))
        return 2
    key = guard_key(gd)
    if not key:
        # 批次 7 T10：vault 未初始化→passphrase 经 PBKDF2+vault/.salt(16B os.urandom)
        # 派生主钥写 vault/.key（hex 文本，load_key 单源读）；缺 passphrase=usage exit 2。
        pp = _read_secret_channel(kv, "--passphrase-stdin", "TANYIN_VAULT_PASSPHRASE")
        if not pp:
            sys.stderr.write("vault 未初始化：需 TANYIN_VAULT_PASSPHRASE（或 --passphrase-stdin）"
                             + "派生主钥" + chr(10))
            return 2
        vd = vault_dir(gd)
        os.makedirs(vd, exist_ok=True)
        salt = os.urandom(16)
        with open(os.path.join(vd, ".salt"), "wb") as f:
            f.write(salt)
        key = vault.derive_key(pp, salt)
        with open(os.path.join(vd, ".key"), "w", encoding="utf-8", newline="\n") as f:
            f.write(key + chr(10))
    n = kv["--cred"]
    payload = enc_payload(key, kv["--username"] + chr(10) + secret)
    os.makedirs(vault_dir(gd), exist_ok=True)
    with open(os.path.join(vault_dir(gd), "cred-%s.enc" % n), "w", encoding="utf-8", newline="\n") as f:
        f.write(payload)
    mp = os.path.join(vault_dir(gd), "manifest.tsv")
    rows = []
    if os.path.exists(mp):
        rows = [l.split(TAB) for l in open(mp, encoding="utf-8").read().splitlines() if l.strip()]
    # v2 算法列（批次 7 T10）：payload=TV2 nonce+EtM——legacy 行保留 xor-sha256 原样（双读过渡）
    rows.append([n, "cred-%s.enc" % n, hashlib.sha256(payload.encode()).hexdigest()[:16], "etm-sha256", "2"])
    with open(mp, "w", encoding="utf-8", newline="\n") as f:  # TSV 落盘一律 LF
        f.write(chr(10).join(TAB.join(r) for r in rows) + chr(10))
    print("OK vault cred-%s 部署" % n)
    return 0

def gate_chain(gd, cmd, ts, cred="", action=""):
    """exec/inject 共用门链（洞 2 修复）：deny-list → nuclei 参数 → scope → permitted_actions → rate → request-ticket。

    门链先于 vault 取件——越权请求的执法结论不因凭据缺失/存在而改变。
    通过返回 None；拒绝返回 1（REJECT 已打印、timeline 已落账）。
    批次 7 T15（High：permitted_actions 零执法→接线）：--cred 在场⇒scope.tsv 须有该
    account 的 account-grant 行（缺=REJECT 无覆盖面）；--action 在场⇒须在该 cred 的
    permitted_actions 并集（分号 _mv 同语义，enforce 单源）；拒绝事件词
    guard-reject permitted-actions 落账留痕。
    OP1（2026-10-14，02-opsec 缺口1）：nuclei 固化参数门（缺 -rl/-etags
    dos,intrusive=REJECT）+ rate 滑窗执法位（goals.rate_limit 已申报⇒执行前置
    核速，超窗=REJECT；单源=enforce.rate_window）。
    """
    # deny-list 双形比对（批次 7 T4，C2 反例一）：字面 joined + argv 归一形
    # （拆组合短旗标/长旗标映射/sh -c 内嵌 payload）——「rm -r -f /」类变体
    # 不再因字面形不匹配逃逸；消息仍出示命中的 deny 模式。
    hit = None
    for form in deny_forms(cmd):
        d = deny_hit(form)
        if d:
            hit = d
            break
    if hit:
        print("REJECT" + TAB + "guard" + TAB + "deny-list 命中: " + hit)
        return 1
    # nuclei OPSEC 参数门（OP1，02-opsec 缺口1「nuclei 无 -rl/-etags」）：经执行
    # 通道的 nuclei 必固化 -rl 限速与 -etags dos,intrusive——调用位在
    # engines/nuclei/adapter.py，此处机械执法防绕过（DoS 风险机械受控）。
    miss = nuclei_params_ok(cmd)
    if miss:
        print("REJECT" + TAB + "guard" + TAB + "nuclei 须固化 -rl 限速与 "
              "-etags dos,intrusive（缺失: " + miss + "）")
        append_tl(gd, ts, "guard-reject nuclei-params missing=" + miss)
        return 1
    # S1（SEC-1 舰 2026-10-15）：执法面写命令对战士只读——approvals/approvers
    # 两账写通道拦截（操作员侧持钥通道；密钥 env 已由 runner 白名单摘出战士面）。
    ro = enforcement_write_hit(cmd)
    if ro:
        print("REJECT" + TAB + "guard" + TAB + "执法面只读: " + ro
              + "（approvals/approvers 写命令走操作员侧通道——战士面禁写）")
        append_tl(gd, ts, "guard-reject enforcement-readonly cmd=" + ro)
        return 1
    s = core.Session(gd)
    # 界外判定只扫参数（cmd[1:]）：argv[0] 是程序路径而非目标主机；Windows 下
    # "C:\Program Files\...\python.exe" 会被空白切分误判为主机名（POSIX 绝对路径则碰巧被跳过）
    bad = out_of_scope_hosts(cmd[1:], load_scope(s))
    if bad:
        host, verdict = bad[0]
        print("REJECT" + TAB + "guard" + TAB + SCOPE_REASON.get(verdict, SCOPE_REASON["out"]) + ": " + host)
        ev = "guard-reject out-of-scope host=" + host + ("" if verdict == "out" else " reason=" + verdict)
        append_tl(gd, ts, ev)
        return 1
    # permitted_actions 覆盖门（批次 7 T15）：先无覆盖面（无 grant 行）后动作并集。
    if cred and not grant_row_exists(s, cred):
        print("REJECT" + TAB + "guard" + TAB + "account-grant 行缺（无覆盖面）: " + cred)
        append_tl(gd, ts, "guard-reject permitted-actions cred=%s no-grant" % cred)
        return 1
    if cred and action and not permitted_actions_covered(s, cred, action):
        print("REJECT" + TAB + "guard" + TAB
              + "permitted-actions cred=%s action=%s 未被 account-grant 覆盖" % (cred, action))
        append_tl(gd, ts, "guard-reject permitted-actions cred=%s action=%s" % (cred, action))
        return 1
    # S3（SEC-1 舰 2026-10-15）：执法钟防时间旅行——自报 --timestamp 降参考，
    # 锚=账本链上时刻（timeline seq 单调+链上时间戳）；战斗内回拨/前跳超容差
    # =REJECT 上账。REJECT 行时戳用链上钟（拒绝行不得把链尖推向谎报时刻）。
    claimed = parse_ts(ts)
    chain = chain_time(s)
    verdict = time_travel_verdict(claimed, chain[0] if chain else None)
    if verdict:
        delta = int(claimed - (chain[0] if chain else claimed))
        print("REJECT" + TAB + "guard" + TAB + "time-travel" + TAB
              + "mode=" + verdict + TAB + "delta=%ds" % delta + TAB
              + "tolerance=%ds" % TIME_TRAVEL_TOLERANCE + TAB
              + "chain=" + (chain[1] if chain else "-"))
        append_tl(gd, (chain[1] if chain else ts),
                  "guard-reject time-travel mode=%s delta=%ds tolerance=%ds"
                  % (verdict, delta, TIME_TRAVEL_TOLERANCE))
        return 1
    # rate 滑窗执法位（OP1，02-opsec 缺口1「budgetctl rate 未接 gate_chain——
    # 真实战从未启用」）：goals.rate_limit 已申报 ⇒ 每次执行前置核速；窗锚=
    # 链上钟钳制后的申报时戳（S3 单源=enforce.enforcement_anchor），超窗
    # used>limit=REJECT 落账。未申报不在本门拦——必填执法位=budgetctl enforce
    # 派发门（P0 八问⑥），本门沿用查询面 env 语义（零破坏过渡）。
    rw = rate_window(s, enforcement_anchor(claimed, chain[0] if chain else None))
    if rw["state"] == "over":
        print("REJECT" + TAB + "guard" + TAB + "rate-limit" + TAB + "used=" + fmt(rw["used"])
              + TAB + "limit=" + fmt(rw["limit"]) + TAB + "window=" + str(rw["window"]) + "s")
        append_tl(gd, ts, "guard-reject rate-limit used=%s limit=%s window=%ds"
                  % (fmt(rw["used"]), fmt(rw["limit"]), rw["window"]))
        return 1
    # OP2（02-opsec 建议表 S 级「request-ticket 落 full argv（tokenize 脱敏）」）：
    # 记账从 cmd[0]+argc 升级为脱敏 full argv——流量画像可重建；vault 真值
    # 复用 tokenize_output 替换（读 manifest 不改判罚语义，加载失败降级旧形）。
    try:
        _secrets = vault_secrets(gd)
    except Exception:
        _secrets = []
    append_tl(gd, ts, "request-ticket argc=%d argv=%s" % (len(cmd), tokenize_argv(cmd, _secrets)))
    return None




def _split_front(rest):
    """剥取 -- 分隔符前的 --cred/--action/--timeout/--timestamp 前置参（批次 7 T15；
    批次 10 T5 增 --timestamp）。返回 (cred, action, timeout_raw, ts, 余下 argv)；
    未知旗标不剥（保既有 usage rc=2 形）。"""
    cred = action = timeout_raw = ts = ""
    i = 0
    while i < len(rest) and rest[i].startswith("--") and rest[i] != "--":
        k, sep, v = rest[i][2:].partition("=")
        if not sep:
            break
        if k == "cred":
            cred = v
        elif k == "action":
            action = v
        elif k == "timeout":
            timeout_raw = v
        elif k == "timestamp":
            ts = v
        else:
            break
        i += 1
    return cred, action, timeout_raw, ts, rest[i:]


def _parse_timeout(raw):
    """--timeout=秒（批次 7 T15，Medium「60s 硬超时」收口）：缺省 60、上限 600、
    下界 1；非法=None（调用方 usage exit 2）。"""
    if not raw:
        return 60
    try:
        t = int(raw)
    except ValueError:
        return None
    return t if 1 <= t <= 600 else None


# ===== B:G2 资源上限（W2·CI 护栏舰附带；B-csai 全件对齐 G2 裁决）=====
# 规格: exec/inject 位统一 resource.setrlimit 三帽(RLIMIT_AS/RLIMIT_NPROC/
# RLIMIT_CPU), 参数=goal 侧 amendment 可调(13 表列集冻结→guard-limits.json
# 侧车承载, 先例=engines task-constraints.json), 施加失败=REJECT(fail-closed
# 同律: 支持面上施加失败子进程绝不执行)。
# 平台边界(实证探针见 tests/test_guard_rlimits_b_g2.py): Windows 无 resource
# 模块——未声明帽=既有行为零漂移(dev/CI 面), 声明了帽=REJECT(声明即执法义务);
# macOS 内核不收任何有限 RLIMIT_AS 值(8G..128G 全拒)——AS 无执法力平台=披露
# 放行(CPU/NPROC 仍帽); cgroup/JobObject 深档=部署文档可选(B:G2 裁决原文)。
# 缺省帽常开(POSIX): as=4G(VA 帽, CSAI 2GB 内存语义放宽防误杀大 VA 预留引擎)/
# nproc=256(CSAI processguard 同值)/cpu=600(=guard --timeout 上限同律背板)。

GUARD_LIMITS_FILE = "guard-limits.json"
RLIMIT_DEFAULTS = {"rlimit_as": 4 << 30, "rlimit_nproc": 256, "rlimit_cpu": 600}
_RLIMIT_BOUNDS = {"rlimit_as": (16 << 20, 64 << 30),
                  "rlimit_nproc": (1, 4096), "rlimit_cpu": (1, 86400)}
_SIZE_SUFFIX = {"K": 1024, "M": 1024 ** 2, "G": 1024 ** 3}


def _parse_size(raw):
    """'512M'/'2G'/整数字节 → 字节数；非法 → None。"""
    if isinstance(raw, bool):
        return None
    if isinstance(raw, int):
        return raw
    m = re.match(r"^(\d+)([KMG])?$", str(raw).strip())
    if not m:
        return None
    return int(m.group(1)) * _SIZE_SUFFIX[m.group(2) or ""]


def load_guard_limits(gd):
    """侧车 → (resolved, err, present)。缺文件=(缺省帽, None, False)。
    坏 JSON/非对象/未知键/值非法或越界=(None, err, True)——fail-closed REJECT 面。"""
    p = os.path.join(gd, GUARD_LIMITS_FILE)
    if not os.path.exists(p):
        return dict(RLIMIT_DEFAULTS), None, False
    try:
        with open(p, encoding="utf-8") as f:
            raw = json.load(f)
    except Exception as e:
        return None, "bad-json(%s)" % e, True
    if not isinstance(raw, dict):
        return None, "sidecar-须为对象", True
    for k in raw:
        if k not in RLIMIT_DEFAULTS:
            return None, "unknown-key:%s" % k, True
    out = dict(RLIMIT_DEFAULTS)
    for k, v in raw.items():
        val = _parse_size(v) if k == "rlimit_as" else v
        if isinstance(val, bool) or not isinstance(val, int):
            return None, "bad-value:%s=%r" % (k, v), True
        lo, hi = _RLIMIT_BOUNDS[k]
        if not lo <= val <= hi:
            return None, "out-of-bounds:%s=%r(域 %d..%d)" % (k, v, lo, hi), True
        out[k] = val
    return out, None, True


def _as_capable(cap):
    """RLIMIT_AS 平台执法力探针（soft-only、set 后即还原=可逆）。
    ValueError(macOS 把内核拒收包成此形)=平台不支持→False 披露放行;
    OSError(Linux 真施加失败/EPERM)=原样上抛→调用方 REJECT(fail-closed)。"""
    res = _resource.RLIMIT_AS
    orig = _resource.getrlimit(res)
    try:
        _resource.setrlimit(res, (cap, orig[1]))
    except ValueError:
        return False
    finally:
        try:
            _resource.setrlimit(res, orig)
        except Exception:
            pass
    return True


def _guard_spawn(gd, ts, cmd, timeout, env=None):
    """exec/inject 单源受帽 spawn: 侧车校验→(amendment 报账)→preexec 施帽。
    施加序 CPU→NPROC→AS(探针过才入列)——支持面上的失败=SubprocessError→
    REJECT, 子进程绝不裸跑。返回 CompletedProcess; REJECT 已打印+落账→None。"""
    limits, err, present = load_guard_limits(gd)
    if err is not None:
        print("REJECT" + TAB + "guard" + TAB + "rlimit" + TAB
              + "reason=bad-limits detail=" + err)
        append_tl(gd, ts, "guard-reject rlimit reason=bad-limits detail=" + err)
        return None
    kw = dict(capture_output=True, text=True, timeout=timeout,
              encoding="utf-8", errors="replace")
    if env is not None:
        kw["env"] = env
    if _resource is None:
        if present:
            print("REJECT" + TAB + "guard" + TAB + "rlimit" + TAB
                  + "reason=platform-missing detail=resource 模块不可用"
                    "（JobObject 档=部署文档可选）")
            append_tl(gd, ts, "guard-reject rlimit reason=platform-missing")
            return None
        return subprocess.run(cmd, **kw)
    try:
        capable = _as_capable(limits["rlimit_as"])
    except OSError:
        print("REJECT" + TAB + "guard" + TAB + "rlimit" + TAB
              + "reason=apply-failed detail=as 探针失败(EPERM/真施加失败)")
        append_tl(gd, ts, "guard-reject rlimit reason=apply-failed detail=as-probe")
        return None
    plan = [(_resource.RLIMIT_CPU, limits["rlimit_cpu"]),
            (_resource.RLIMIT_NPROC, limits["rlimit_nproc"])]
    if capable:
        plan.append((_resource.RLIMIT_AS, limits["rlimit_as"]))
    if present:   # amendment 审计镜像（缺省路径零新行=既有行数断言面不破）
        note = "" if capable else " as-disclose=platform-unsupported"
        append_tl(gd, ts, "guard-rlimit as=%d nproc=%d cpu=%d src=%s%s"
                  % (limits["rlimit_as"], limits["rlimit_nproc"],
                     limits["rlimit_cpu"], GUARD_LIMITS_FILE, note))

    def _apply():
        for res, val in plan:
            _resource.setrlimit(res, (val, val))

    try:
        return subprocess.run(cmd, preexec_fn=_apply, **kw)
    except subprocess.TimeoutExpired:
        raise   # 墙钟超时≠施加失败——交调用方 timeout REJECT 面
    except subprocess.SubprocessError:
        print("REJECT" + TAB + "guard" + TAB + "rlimit" + TAB
              + "reason=apply-failed detail=setrlimit 施加失败，子进程未执行")
        append_tl(gd, ts, "guard-reject rlimit reason=apply-failed")
        return None


def cmd_exec(gd, rest, ts=None):
    cred, action, timeout_raw, front_ts, rest = _split_front(rest)
    ts = ts or front_ts   # 前置 --timestamp 形（批次 10 T5）
    if not rest or rest[0] != "--":
        sys.stderr.write("exec 需要 -- 分隔命令" + chr(10))
        return 2
    t = _parse_timeout(timeout_raw)
    if t is None:
        sys.stderr.write("用法错误: --timeout=秒（整数 1..600，缺省 60）" + chr(10))
        return 2
    cmd = rest[1:]
    if not cmd:
        return 2
    # 批次 10 T5（P2#9）：EPOCH 缺省退役——时间戳一律显式（--timestamp=ISO8601）。
    if not ts:
        sys.stderr.write("exec 须带 --timestamp=ISO8601（EPOCH 缺省已退役）" + chr(10))
        return 2
    rc = gate_chain(gd, cmd, ts, cred=cred, action=action)
    if rc is not None:
        return rc
    try:
        r = _guard_spawn(gd, ts, cmd, t)   # B:G2: 受帽 spawn（REJECT→None）
    except subprocess.TimeoutExpired:
        print("REJECT" + TAB + "guard" + TAB + "timeout t=%ds（guard --timeout 通道，缺省 60 上限 600）" % t)
        return 1
    except FileNotFoundError:
        print("REJECT" + TAB + "guard" + TAB + "命令不存在: " + cmd[0])
        return 1
    if r is None:   # B:G2: 帽校验/施加 REJECT 已打印落账
        return 1
    secrets = vault_secrets(gd)
    sys.stdout.write(tokenize_output(r.stdout, secrets))
    sys.stderr.write(tokenize_output(r.stderr, secrets))  # 洞 3：stderr 同脱敏
    return r.returncode

def main(argv):
    if len(argv) < 4 or argv[2] != "--goal-dir":
        return usage()
    sub, gd, rest = argv[1], argv[3], argv[4:]
    if not os.path.isdir(gd):
        sys.stderr.write("环境问题: goal 目录不存在" + chr(10))
        return 2
    if sub == "exec":
        return cmd_exec(gd, rest)
    if sub == "deploy-vault":
        return cmd_deploy_vault(gd, rest)
    if sub == "inject":
        kv = dict(a.partition("=")[::2] for a in rest if a.startswith("--"))
        cmd = rest[rest.index("--") + 1:] if "--" in rest else []
        if not kv.get("--cred") or not cmd:
            sys.stderr.write("inject 需要 --cred=N 与 -- 命令" + chr(10))
            return 2
        # 批次 7 T15：凭据必有意图动作——inject 带 --cred 时 --action 必填（usage exit 2）。
        if not kv.get("--action"):
            sys.stderr.write("inject 凭据注入须带 --action=<意图动作>（permitted_actions 执法面）"
                             + chr(10))
            return 2
        t = _parse_timeout(kv.get("--timeout", ""))
        if t is None:
            sys.stderr.write("用法错误: --timeout=秒（整数 1..600，缺省 60）" + chr(10))
            return 2
        # 洞 2 修复：inject 执行前走与 exec 完全相同的门链（deny-list→scope→
        # permitted_actions→取票），只有凭据注入环节不同；门链先于 vault 取件。
        # 批次 10 T5（P2#9）：EPOCH 缺省退役——--timestamp 必填。
        if not kv.get("--timestamp"):
            sys.stderr.write("inject 须带 --timestamp=ISO8601（EPOCH 缺省已退役）" + chr(10))
            return 2
        rc = gate_chain(gd, cmd, kv["--timestamp"],
                        cred=kv["--cred"], action=kv["--action"])
        if rc is not None:
            return rc
        u, sec = read_cred(gd, kv["--cred"])
        if sec is None:
            print("REJECT" + TAB + "guard" + TAB + "vault 条目缺失 cred-" + kv["--cred"])
            return 1
        env = dict(os.environ)
        env["TY_CRED_USER"] = u or ""
        env["TY_CRED_SECRET"] = sec
        append_tl(gd, kv["--timestamp"], "vault-inject cred=" + kv["--cred"])
        try:
            r = _guard_spawn(gd, kv["--timestamp"], cmd, t, env=env)   # B:G2 同帽
        except subprocess.TimeoutExpired:
            print("REJECT" + TAB + "guard" + TAB + "timeout t=%ds（guard --timeout 通道，缺省 60 上限 600）" % t)
            return 1
        except FileNotFoundError:
            print("REJECT" + TAB + "guard" + TAB + "命令不存在: " + cmd[0])
            return 1
        if r is None:   # B:G2: 帽校验/施加 REJECT 已打印落账
            return 1
        secrets = vault_secrets(gd)
        sys.stdout.write(tokenize_output(r.stdout, secrets))
        sys.stderr.write(tokenize_output(r.stderr, secrets))  # 洞 3：stderr 同脱敏
        return r.returncode
    return usage()

if __name__ == "__main__":
    sys.exit(main(sys.argv))