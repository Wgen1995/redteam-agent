#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-serve（W2 serve 收口 · W1 遗留 T3）——单命令起 webui 方向盘。

宪法#3 红字: clone 即用 —— tanyin-serve start 一条命令后台起 webui
（自动选口 / 静默后台 / 日志落位 $TANYIN_HOME/serve/serve.log，
状态文件 serve.json 单实例模型——对齐 tanyin-* 家族风格）。

CLI 输出契约（与 W2b 单源退出码矩阵对齐）:
  --json  全命令旗标: stdout=单个 JSON 对象（json.loads 直读不炸，零装饰行；
          test_ui_craft 钉页面 CSS 纯净，本旗标对称钉 stdout 纯净）。
  退出码  0 成功 / 1 REJECT（start 已在跑 · stop/status 未在跑）
          2 用法·环境（未知子命令/旗标、缺 ledger 目录、端口区间全忙）；
          未预期异常同样 rc2 但 stderr 带 gate-error: 前缀（bug 永不伪装 1）
          3 黄灯（status: stale=状态在而进程亡 / degraded=进程在而端点不应答）。
"""
import http.client
import json, os, signal, socket, subprocess, sys, time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger.core import ensure_utf8_stdio  # noqa: E402

ensure_utf8_stdio()   # Windows 控制台 GBK: 中文提示统一 UTF-8

DEFAULT_HOST, DEFAULT_PORT = "127.0.0.1", 8900   # 缺省口=产品形态钉（--help 披露）
PORT_SCAN_SPAN = 20      # 有界扫描: 请求口起连续 20 口全忙=环境域 rc2（不无限漂移）
READY_TIMEOUT_S = 15.0   # 点火后等 webui 端点应答上限（超时=rc2 附日志尾）
STOP_WAIT_S = 6.0        # SIGTERM 后等进程退出的上限（超时=SIGKILL 补刀）
SUBS = ("start", "status", "stop")
FLAGS = ("--ledger-dir", "--port", "--host", "--json")
USAGE = (
    "用法: tanyin-serve <start|status|stop> [--ledger-dir D] [--port N] [--host H] [--json]" + chr(10)
    + "  start   后台起 webui（缺省口 8900，忙则紧邻自动改口；缺省 ledger=最新战）" + chr(10)
    + "  status  查在跑状态（running / not-running / stale / degraded）" + chr(10)
    + "  stop    停后台 webui 并归还端口" + chr(10)
    + "  --json  stdout=单 JSON 对象（机器直读）；缺省=给人看的行")


# ---------------------------------------------------------------- 状态与探针

def _state_dir():
    """$TANYIN_HOME/serve（缺省 ~/.tanyin/serve）——状态+日志落位（禁令#34: 不落 /tmp）。"""
    home = os.environ.get("TANYIN_HOME") or os.path.join(os.path.expanduser("~"), ".tanyin")
    return os.path.join(home, "serve")


def _state_path():
    return os.path.join(_state_dir(), "serve.json")


def _log_path():
    return os.path.join(_state_dir(), "serve.log")


def _read_state():
    try:
        with open(_state_path(), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def _port_free(port):
    """bind 探测即释放（存在微小竞态，由点火后端点探活兜底）。"""
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def _http_status(port, host=DEFAULT_HOST, timeout=2.0):
    """探活: 返回 HTTP 状态码（favicon 消音口=未登录开放面）; 连不上返回 None。"""
    try:
        conn = http.client.HTTPConnection(host, int(port), timeout=timeout)
        conn.request("GET", "/favicon.ico")
        resp = conn.getresponse()
        resp.read()
        conn.close()
        return resp.status
    except OSError:
        return None


def _latest_goal_dir():
    """缺省 ledger=最新战最新 goal（mtime 序; battle 无 goal 则让位次新战）。"""
    from ledger.trace_search import default_battles_dir
    root = default_battles_dir()
    if not os.path.isdir(root):
        return ""
    battles = sorted((os.path.join(root, d) for d in os.listdir(root)
                      if d.startswith("battle-")
                      and os.path.isdir(os.path.join(root, d))),
                     key=os.path.getmtime, reverse=True)
    for b in battles:
        gs = [os.path.join(b, g) for g in os.listdir(b)
              if g.startswith("G-") and os.path.isdir(os.path.join(b, g))]
        if gs:
            return max(gs, key=os.path.getmtime)
    return ""


# ---------------------------------------------------------------- 输出面

def _emit(payload, json_mode):
    """单点输出: --json=stdout 单 JSON 对象（纯净钉）; 人话=关键行。"""
    if json_mode:
        print(json.dumps(payload, ensure_ascii=False))
        return
    if payload.get("url"):
        print(payload["url"])
    if payload.get("pid"):
        print("pid=%s 日志=%s" % (payload.get("pid"), payload.get("log", "")))


def _fail(action, rc, reason, json_mode, usage=False, extra=None):
    payload = {"ok": False, "action": action, "reason": reason}
    if extra:
        payload.update(extra)
    if json_mode:
        print(json.dumps(payload, ensure_ascii=False))
    else:
        sys.stderr.write(reason + chr(10))
        if usage:
            sys.stderr.write(USAGE + chr(10))
    return rc


def _parse(rest):
    """--key=value / --key value 双形态归一（tanyin-viz 同款）; 裸旗标值=空串。"""
    kv, i = {}, 0
    while i < len(rest):
        a = rest[i]
        if not a.startswith("--"):
            return None, "未知参数: " + a
        if "=" in a:
            kv[a.split("=", 1)[0]] = a.partition("=")[2]
            i += 1
        elif i + 1 < len(rest) and not rest[i + 1].startswith("--"):
            kv[a] = rest[i + 1]
            i += 2
        else:
            kv[a] = ""
            i += 1
    unknown = [k for k in kv if k not in FLAGS]
    if unknown:
        return None, "未知旗标: " + ",".join(sorted(unknown))
    if "--port" in kv and kv["--port"] != "":
        try:
            kv["--port"] = int(kv["--port"])
        except (TypeError, ValueError):
            return None, "--port 须整数"
    return kv, None


# ---------------------------------------------------------------- 子命令

def _cmd_start(kv, json_mode):
    gd = kv.get("--ledger-dir", "")
    if not gd:
        gd = _latest_goal_dir()
        if not gd:
            return _fail("start", 2, "环境问题: 未找到可服 ledger（battles 下无战"
                                     "且未给 --ledger-dir）——先建战或用 --ledger-dir 指定",
                         json_mode)
    if not os.path.isdir(gd):
        return _fail("start", 2, "环境问题: ledger 目录不存在 " + gd, json_mode)
    st = _read_state()
    if st and _pid_alive(st.get("pid")):   # 单实例: 已在跑=REJECT rc1（launch 先例）
        return _fail("start", 1, "already-running", json_mode,
                     extra={"state": "running", "pid": st.get("pid"),
                            "url": st.get("url", ""), "port": st.get("port")})
    host = kv.get("--host") or DEFAULT_HOST
    requested = kv.get("--port")
    requested = DEFAULT_PORT if requested in (None, "") else int(requested)
    chosen = None
    for off in range(PORT_SCAN_SPAN):      # 冲突降级: 紧邻下一空闲口（有界 20 止）
        cand = requested + off
        if _port_free(cand):
            chosen = cand
            break
    if chosen is None:
        return _fail("start", 2, "环境问题: 端口 %d 起连续 %d 口全忙"
                                 % (requested, PORT_SCAN_SPAN), json_mode)
    os.makedirs(_state_dir(), exist_ok=True)
    log = _log_path()
    cli_dir = os.path.dirname(os.path.abspath(__file__))
    with open(log, "ab") as lf:            # 静默后台: 输出全量落 serve.log
        proc = subprocess.Popen(   # -m webui.server=家族规范起法（相对导入面）
            [sys.executable, "-u", "-m", "webui.server", "--ledger-dir", gd,
             "--host", host, "--port", str(chosen)],
            stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
            cwd=cli_dir, start_new_session=True)
    deadline = time.time() + READY_TIMEOUT_S
    while time.time() < deadline:
        if _http_status(chosen, host) is not None:
            break
        if proc.poll() is not None:        # 进程早夭（如端口被抢 bind 失败）
            break
        time.sleep(0.1)
    if _http_status(chosen, host) is None:
        proc.kill()
        tail = ""
        try:
            with open(log, encoding="utf-8", errors="replace") as f:
                tail = f.read()[-400:]
        except OSError:
            pass
        return _fail("start", 2, "环境问题: webui 点火后端点未应答（端口 %d）日志尾: %s"
                                 % (chosen, tail), json_mode)
    state = {"pid": proc.pid, "port": chosen, "host": host,
             "url": "http://%s:%d/" % (host, chosen),
             "ledger_dir": gd, "log": log,
             "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    with open(_state_path(), "w", encoding="utf-8", newline="\n") as f:
        json.dump(state, f, ensure_ascii=False, indent=2)
        f.write("\n")
    payload = {"ok": True, "action": "start", "state": "running",
               "requested_port": requested}
    payload.update(state)
    _emit(payload, json_mode)
    return 0


def _cmd_status(kv, json_mode):
    st = _read_state()
    if not st:
        return _fail("status", 1, "not-running", json_mode,
                     extra={"state": "not-running"})
    pid = st.get("pid")
    if not _pid_alive(pid):
        return _fail("status", 3, "stale: 状态文件在而进程亡（pid=%s）——"
                                  "不静默绿（W2b rc3 黄灯）" % pid, json_mode,
                     extra={"state": "stale", "pid": pid})
    if _http_status(st.get("port", 0), st.get("host", DEFAULT_HOST)) is None:
        return _fail("status", 3, "degraded: 进程在而端点不应答"
                                  "（pid=%s port=%s）——不静默绿（W2b rc3 黄灯）"
                                  % (pid, st.get("port")), json_mode,
                     extra={"state": "degraded", "pid": pid})
    payload = {"ok": True, "action": "status", "state": "running"}
    payload.update({k: st[k] for k in
                    ("pid", "port", "host", "url", "ledger_dir", "log")
                    if k in st})
    _emit(payload, json_mode)
    return 0


def _cmd_stop(kv, json_mode):
    st = _read_state()
    if not st or not _pid_alive(st.get("pid")):
        try:
            os.remove(_state_path())       # 残状态出清（进程已亡=不在跑）
        except OSError:
            pass
        return _fail("stop", 1, "not-running", json_mode,
                     extra={"state": "not-running"})
    pid = int(st["pid"])
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    deadline = time.time() + STOP_WAIT_S
    while time.time() < deadline and _pid_alive(pid):
        time.sleep(0.1)
    if _pid_alive(pid):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        time.sleep(0.2)
    try:
        os.remove(_state_path())
    except OSError:
        pass
    _emit({"ok": True, "action": "stop", "state": "stopped",
           "pid": st.get("pid"), "port": st.get("port"),
           "url": st.get("url", "")}, json_mode)
    return 0


# ---------------------------------------------------------------- 入口

def main(argv):
    json_mode = "--json" in argv[1:]
    try:
        return _dispatch(argv, json_mode)
    except SystemExit:
        raise
    except Exception as e:   # noqa: BLE001 — W2b P0-3: bug 永不伪装 1
        msg = "gate-error: %s: %s" % (type(e).__name__, e)
        sys.stderr.write(msg + chr(10))
        if json_mode:
            print(json.dumps({"ok": False, "action": "?", "reason": msg},
                             ensure_ascii=False))
        return 2


def _dispatch(argv, json_mode):
    args = argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    sub = args[0]
    if sub not in SUBS:
        return _fail(sub, 2, "未知子命令: %s（可用: %s）" % (sub, "/".join(SUBS)),
                     json_mode, usage=True)
    kv, err = _parse(args[1:])
    if err:
        return _fail(sub, 2, err, json_mode, usage=True)
    if sub == "start":
        return _cmd_start(kv, json_mode)
    if sub == "status":
        return _cmd_status(kv, json_mode)
    return _cmd_stop(kv, json_mode)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
