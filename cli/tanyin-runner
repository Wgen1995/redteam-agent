#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-runner · 形态 B 引擎（薄保姆）

采纳 vuln_agent opencode_wrapper 的工程要点（隔离环境变量/进程组击杀/超时管制），
叠加心跳监控+停滞检测+死亡自动续跑（opencode run -c 续会话）。
op-1 三连死（权限墙×2+子代理派发后无声死亡）的立项书。

用法:
  python3 cli/tanyin-runner start --cwd <仓库> --prompt-file <f> \\
      --log <主日志> --ledger-dir <账本目录> [--max-restarts 5] [--stall-min 8]
"""
import argparse
import datetime
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger import watchdog as wd  # noqa: E402  b10 看门狗计算核（零依赖）
from ledger import egress_mount  # noqa: E402  SEC-2 舰 S2（v0.9.6）：Tier3 egress 实挂

ISOLATION_ENV = {
    "OPENCODE_DISABLE_AUTOUPDATE": "true",
    "OPENCODE_DISABLE_DEFAULT_PLUGINS": "true",
    "OPENCODE_DISABLE_MODELS_FETCH": "true",
    "OPENCODE_DISABLE_PRUNE": "true",
    "OPENCODE_SKIP_SAFE_CHECK": "1",
}

# SEC-1 舰 S1（2026-10-15 v0.9.6）：战士进程 env 白名单——信任根摘出。
# 继承面只放行必需系统变量 + 非密 TANYIN_HOME/TANYIN_UA。grep 全仓 TANYIN_*
# 注入点逐一过白名单：judge_client 的 JUDGE_*（judge API key）、write_cmds 的
# APPROVAL_KEY（审批 HMAC 钥）、vault 的 VAULT_*（主钥/口令/密钥文件）、
# zhulong_export 的 ZHULONG_*（外送凭据）、check_cmds/phases 的 ANCHOR_*、
# llmpool 的 LLMPOOL_STATE、evals 的 RANGE_SESSION、webui 的 WEBUI_DEBUG、
# viz 的 VIZ_DATA__——密钥类/操作员面配置全剥离，密钥永不进战士 env。
WARRIOR_ENV_ALLOW = {
    "PATH", "HOME", "LANG", "LC_ALL", "LC_CTYPE", "LC_MESSAGES", "TERM",
    "TMPDIR", "TMP", "TEMP", "SHELL", "USER", "LOGNAME", "USERNAME",
    "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME",
    "TANYIN_HOME", "TANYIN_UA",
}


def warrior_env(base=None):
    """战士进程最小 env：白名单外全剥离（自报 base 缺省=操作员 os.environ）。

    S1 信任根摘出单源：launch() 一律经此建 env——旧形 dict(os.environ) 退役。
    """
    base = os.environ if base is None else base
    return {k: v for k, v in base.items() if k in WARRIOR_ENV_ALLOW}

RESUME_PREAMBLE = (
    "【引擎续跑】上一会话中断。本任务状态全落盘于账本（不依赖会话记忆）："
    "先走恢复协议（verify-chain -> state-rebuild -> resume-kit），再从中断处继续，勿重复已落账条目。"
    "以下是本任务的完整任务书，重读并执行：\n\n"
)


def now():
    return datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")


def log_event(runner_log, event, detail=""):
    """runner.tsv 行 + 帧文件双写（W2·C:G2 帧化：kind 词面同源、schema_version
    锚+seq；帧=审计镜像，写失败不阻主流程）。杀点调用序=先 log_event 后
    kill_group（DIRECTIVE/STALL/BUDGET-ENFORCE/ASK-ANSWERED 全在杀前记账），
    双写后「先写帧后杀」纪律自持——取消/续跑的尾账不再丢。"""
    ts = now()
    line = "%s\t%s\t%s" % (ts, event, detail)
    with open(runner_log, "a", encoding="utf-8") as f:
        f.write(line + "\n")
    from ledger.frames import append_frame, frames_path_for
    append_frame(frames_path_for(runner_log), ts, event, detail=detail)
    print("[runner] " + line)


def fsize(path):
    try:
        return os.path.getsize(path)
    except OSError:
        return 0


def timeline_rows(ledger_dir):
    p = os.path.join(ledger_dir, "timeline.tsv")
    try:
        with open(p, encoding="utf-8") as f:
            return sum(1 for _ in f)
    except OSError:
        return 0


def kill_group(proc):
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.kill()
        except OSError:
            pass


def launch(cwd, prompt, log_path, model=None, env_extra=None):
    cmd = ["opencode", "run"]
    if model:
        cmd += ["--model", model]
    cmd.append(prompt)
    env = warrior_env()   # S1：战士面白名单 env（密钥类 TANYIN_* 全剥离）
    env.update(ISOLATION_ENV)
    # SEC-2 舰 S2：env 强制出网上代理（HTTP(S)_PROXY/NO_PROXY）——战士进程
    # 零配合零感知，出网机械过 egress decide 四态（egress_mount 单源）。
    env.update(env_extra or {})
    logf = open(log_path, "a", encoding="utf-8")
    kw = dict()
    if os.name == "nt":
        kw["creationflags"] = subprocess.CREATE_NO_WINDOW
    else:
        kw["start_new_session"] = True
    proc = subprocess.Popen(
        cmd, cwd=cwd, stdout=logf, stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL, env=env, **kw,
    )
    return proc


def battle_complete(ledger_dir, runner_log=None):
    """战毕判据（v0.5a F1：弃裸 grep 改判据层只读 API）：P4 门 PASS。

    tanyin-phases status=单源状态机读口；API 不可用回落旧 grep 并 WARN 一次
    （rc=0 不算完成——battle-23 实证：读文档后假完成）。"""
    argv = [sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                         "tanyin-phases"),
            "status", "--goal-dir", ledger_dir, "--phase=P4"]
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30)
        if r.returncode == 0 and "result=PASS" in r.stdout:
            return True
        if r.returncode == 0:
            return False
    except (OSError, subprocess.TimeoutExpired):
        pass
    if runner_log:
        log_event(runner_log, "WARN", "status API 不可用，回落 grep 判据")
    p = os.path.join(ledger_dir, "timeline.tsv")
    try:
        with open(p, encoding="utf-8", errors="replace") as f:
            return "gate-exit:P4" in f.read()
    except OSError:
        return False


def notify_user(title, message):
    """v0.5a F6：macOS 通知（尽力而为——osascript 缺失/失败不阻流程）。"""
    try:
        subprocess.run(["osascript", "-e",
                        'display notification "%s" with title "%s"' % (message, title)],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


BUDGET_WRAPUP = (
    "【预算执法】预算已超限：立即停止一切新探测/新意图。收尾序列："
    "supersede-finding 去重 → findings/E-index 补全 → 走 P4/P5 重放与终态门。"
    "禁止再产生新 request。"
)


def main():
    ap = argparse.ArgumentParser(prog="tanyin-runner")
    sub = ap.add_subparsers(dest="cmd", required=True)
    st = sub.add_parser("start")
    st.add_argument("--cwd", required=True)
    st.add_argument("--prompt-file", required=True)
    st.add_argument("--log", required=True)
    st.add_argument("--ledger-dir", required=True)
    st.add_argument("--runner-log", default=None)
    st.add_argument("--max-restarts", type=int, default=5)
    st.add_argument("--stall-min", type=float, default=8.0)      # hard：击杀阈值（分钟）
    st.add_argument("--soft-stall-min", type=float, default=3.0)  # soft：观察阈值（分钟，b10）
    st.add_argument("--backoff-base", type=float, default=30.0)   # 重启退避基秒（b10：base*4^(n-1) 封顶480）
    st.add_argument("--directive-file", default=None)             # 战中指令控制文件（b10：digest 变化触发带令续跑）
    st.add_argument("--tick-sec", type=float, default=30.0)
    st.add_argument("--model", default=None)
    st.add_argument("--caffeinate", action="store_true",
                    help="v0.5a F6：spawn caffeinate -dims 防系统睡眠（无人值守战）")
    st.add_argument("--ask-file", default=None,
                    help="v0.5a F5：ask:human 通道文件（战士写问题，人工写 <f>.answer.md）")
    args = ap.parse_args()

    runner_log = args.runner_log or (args.log + ".runner.tsv")
    with open(args.prompt_file, encoding="utf-8") as f:
        first_prompt = f.read().strip()
    # b10 修复：HEAD 版 resume_prompt 从未定义（重启路径 NameError 潜伏）——
    # 续跑提示=恢复协议导语+完整任务书重读
    resume_prompt = RESUME_PREAMBLE + first_prompt

    log_event(runner_log, "BOOT",
              "cwd=%s max_restarts=%d stall=%.1fm soft=%.1fm backoff=%.0fs directive=%s" % (
                  args.cwd, args.max_restarts, args.stall_min, args.soft_stall_min,
                  args.backoff_base, args.directive_file or "off"))
    # S1：env 白名单摘除披露——只记变量名不记值（密钥名上账、真值零落盘）。
    _scrub_all = sorted(k for k in os.environ if k not in WARRIOR_ENV_ALLOW)
    _scrub_tanyin = [k for k in _scrub_all if k.startswith("TANYIN_")]
    if _scrub_all:
        log_event(runner_log, "ENV-SCRUB",
                  "stripped=%d tanyin=%s" % (len(_scrub_all), ",".join(_scrub_tanyin) or "-"))
    # SEC-2 舰 S2（v0.9.6）：Tier3 egress 实挂——egress.acl 在场即内嵌起代理
    # （127.0.0.1 随机端口，随战斗生命周期开关）；无 compile 产物=off 如实披露；
    # ACL 损坏=fail-closed 拒启动（零执法静默降级禁止）。安装/自检步骤见
    # cli/ledger/egress_mount.py 模块 docstring（不动 ZhuLong——8900 常驻）。
    try:
        egm = egress_mount.mount(args.ledger_dir)
    except ValueError as e:
        log_event(runner_log, "EGRESS-MOUNT-REJECT", "acl 不合法 fail-closed 拒启动: %s" % e)
        return 2
    if egm:
        log_event(runner_log, "EGRESS-MOUNT",
                  "port=%d log=%s（子进程 env 已强制代理；安装/自检见 egress_mount.py）"
                  % (egm.port, egm.egress_log))
    else:
        log_event(runner_log, "EGRESS-MOUNT", "off（无 egress.acl——先 tanyin-egress compile）")
    war_env = egm.env() if egm else None
    proc = launch(args.cwd, first_prompt, args.log, args.model, env_extra=war_env)
    log_event(runner_log, "LAUNCH", "pid=%d (first prompt)" % proc.pid)

    restarts = 0
    last_log_sz = fsize(args.log)
    last_tl = timeline_rows(args.ledger_dir)
    last_progress = time.time()
    directive_seen = None          # b10：指令注入通道 digest
    soft_announced = False         # b10：每个停滞回合只记一次 SOFTSTALL
    tick = args.tick_sec
    # v0.5a 状态：预算执法/LOGONLY/ask-WAIT/caffeinate
    last_budget_at, budget_warned, budget_enforced = 0.0, False, False
    logonly_since, logonly_emitted = None, False
    wait_announced = False
    caffeinate_proc = None
    if args.caffeinate:
        try:
            caffeinate_proc = subprocess.Popen(["caffeinate", "-dims"],
                                               stdout=subprocess.DEVNULL,
                                               stderr=subprocess.DEVNULL)
        except OSError:
            log_event(runner_log, "WARN", "caffeinate 不可用（非 macOS？）防睡降级关闭")

    def relaunch(extra="", why=""):
        """b10 统一重启口：退避→LAUNCH（可带战中指令）。"""
        nonlocal restarts, last_progress, last_log_sz, directive_seen, soft_announced, tick
        delay = wd.backoff_delay(restarts, base=args.backoff_base)
        if delay > 0:
            log_event(runner_log, "BACKOFF", "%.0fs before restart n=%d" % (delay, restarts + 1))
            time.sleep(delay)
        prompt = (resume_prompt + "\n\n" + extra.strip()) if extra.strip() else resume_prompt
        proc = launch(args.cwd, prompt, args.log, args.model, env_extra=war_env)
        restarts += 1
        last_progress = time.time()
        last_log_sz = fsize(args.log)
        soft_announced = False
        tick = 1.0
        log_event(runner_log, "RESTART", "pid=%d n=%d%s" % (proc.pid, restarts, (" (" + why + ")") if why else ""))
        return proc

    while True:
        time.sleep(tick)
        rc = proc.poll()
        sz = fsize(args.log)
        tl = timeline_rows(args.ledger_dir)
        active = sz != last_log_sz or tl != last_tl
        # SEC-2 舰 S2：egress-log 增量 -> timeline request-ticket 机械记账
        # （active 判定先于记账——本 tick 铸的票不冒充本 tick 的战士活性）。
        if egm:
            egm.poll_tickets(args.ledger_dir)
        tick = wd.next_tick(active, tick=args.tick_sec)   # b10：自适应监听
        # b10：战中指令通道——digest 变化才触发（kill+带令续跑=multica pending 语义）
        if args.directive_file:
            dtext, dnew = wd.read_directive(args.directive_file, directive_seen)
            if dtext is not None:
                directive_seen = dnew
                log_event(runner_log, "DIRECTIVE", "digest=%.12s len=%d" % (dnew, len(dtext)))
                kill_group(proc)
                proc.wait()
                proc = relaunch(extra=dtext, why="directive")
                continue
        # v0.5a F5：ask:human 双向通道——问题在场=WAIT（停表不停命），答案落盘=注入续跑
        if args.ask_file:
            q = wd.ask_question(args.ask_file)
            if q:
                ans_path = args.ask_file + ".answer.md"
                a = wd.ask_question(ans_path)
                if wd.wait_state(ask_pending=True, answered=bool(a)) == "WAIT":
                    if not wait_announced:
                        wait_announced = True
                        log_event(runner_log, "ASK", "pending: %s" % q[:120].replace(chr(10), " "))
                        notify_user("探隐 ask:human", "战士提问，等待人工作答")
                    last_progress = time.time()   # WAIT：停滞计时停走
                    continue
                log_event(runner_log, "ASK-ANSWERED", "len=%d injecting" % len(a))
                notify_user("探隐 ask:human", "答案已注入，续跑")
                try:
                    os.replace(ans_path, ans_path + ".consumed")
                    with open(args.ask_file, "w", encoding="utf-8") as f:
                        f.write("")   # 清问题（已答）
                except OSError:
                    pass
                wait_announced = False
                kill_group(proc)
                proc.wait()
                proc = relaunch(extra="【人工答复合位】" + a, why="ask-answered")
                continue
        # v0.5a F3：预算执法——战中快照超限即带收尾令重启（申报制→执法制）
        if time.time() - last_budget_at > 30 and not budget_enforced:
            last_budget_at = time.time()
            br = subprocess.run([sys.executable, os.path.join(
                os.path.dirname(os.path.abspath(__file__)), "tanyin-ledger"),
                "budget-check", "--goal-dir", args.ledger_dir],
                capture_output=True, text=True, timeout=30)
            parsed = wd.budget_usage(br.stdout.splitlines()[0]) if br.stdout.strip() else None
            if parsed:
                used, limit = parsed
                bstate = wd.budget_state(used, limit)
                if bstate == "warn" and not budget_warned:
                    budget_warned = True
                    log_event(runner_log, "BUDGET-WARN",
                              "token=%s/%s" % (used.get("token"), limit.get("token")))
                if bstate == "over":
                    budget_enforced = True
                    log_event(runner_log, "BUDGET-ENFORCE",
                              "over limit token=%s/%s hours=%s/%s -> wrap-up directive"
                              % (used.get("token"), limit.get("token"),
                                 used.get("hours"), limit.get("hours")))
                    notify_user("探隐 runner", "预算超限，已注入收尾令")
                    kill_group(proc)
                    proc.wait()
                    proc = relaunch(extra=BUDGET_WRAPUP, why="budget-enforce")
                    continue
        if active:
            # v0.5a F4：LOGONLY-ALIVE——log 长而 timeline 不动=账本外干活的气味（照亮不击杀）
            if wd.is_logonly(sz != last_log_sz, tl != last_tl):
                if logonly_since is None:
                    logonly_since = time.time()
                elif wd.logonly_should_emit(logonly_emitted,
                                            time.time() - logonly_since,
                                            args.soft_stall_min * 60):
                    logonly_emitted = True
                    log_event(runner_log, "LOGONLY-ALIVE",
                              "log growing %.1fm without timeline rows (observe)"
                              % ((time.time() - logonly_since) / 60))
            else:
                logonly_since, logonly_emitted = None, False
            last_log_sz, last_tl = sz, tl
            last_progress = time.time()
            soft_announced = False
            log_event(runner_log, "PROGRESS", "log=%dB timeline=%d" % (sz, tl))
            if rc is not None:
                log_event(runner_log, "EXIT", "rc=%s after progress complete=%s" % (rc, battle_complete(args.ledger_dir, runner_log)))
                if battle_complete(args.ledger_dir, runner_log) or restarts >= args.max_restarts:
                    if not battle_complete(args.ledger_dir, runner_log):
                        log_event(runner_log, "GIVEUP", "restarts=%d incomplete-exit" % restarts)
                        notify_user("探隐 runner", "GIVEUP：战未毕且重启耗尽")
                    break
                proc = relaunch(why="incomplete-exit resume")
                continue
            continue
        stall_sec = time.time() - last_progress
        grade = wd.stall_grade(stall_sec, soft=args.soft_stall_min * 60, hard=args.stall_min * 60)
        if grade == "soft" and not soft_announced:
            soft_announced = True
            log_event(runner_log, "SOFTSTALL", "no progress %.1fm (observe; log=%dB timeline=%d)" % (stall_sec / 60, sz, tl))
        if rc is not None:
            log_event(runner_log, "EXIT", "rc=%s (idle)" % rc)
            if restarts >= args.max_restarts:
                log_event(runner_log, "GIVEUP", "restarts=%d" % restarts)
                notify_user("探隐 runner", "GIVEUP：战未毕且重启耗尽")
                break
            proc = relaunch(why="resume")
            continue
        if grade == "hard":
            log_event(runner_log, "STALL", "no progress %.1fm; killing pid=%d" % (stall_sec / 60, proc.pid))
            kill_group(proc)
            proc.wait()
            if restarts >= args.max_restarts:
                log_event(runner_log, "GIVEUP", "restarts=%d after stall" % restarts)
                notify_user("探隐 runner", "GIVEUP：stall 击杀后重启耗尽")
                break
            proc = relaunch(why="after stall")

    rc = proc.poll()
    log_event(runner_log, "DONE", "final_rc=%s restarts=%d timeline=%d" % (rc, restarts, timeline_rows(args.ledger_dir)))
    if egm:
        egm.poll_tickets(args.ledger_dir)   # 收尾轮：战尾判决不漏记
        egm.shutdown()                      # 随战斗生命周期关停（无常驻进程）
    notify_user("探隐 runner", "战毕 DONE restarts=%d" % restarts)
    if caffeinate_proc:
        try:
            caffeinate_proc.terminate()
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
