#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-budgetctl（批次 2 T5）——预算树余量门（enforce）+ 速率滑窗熔断（rate）。

enforce --intent-id：add-intent 前置门（§8.7）。goals.budget 三元组 vs budget.tsv 已耗上卷聚合
  （只读复用批次 1 query_cmds.budget_tree）；任一维 used>=limit=REJECT budget-exhausted（exit 1，
  零余量即拒派——不存在「再跑一轮看看」）；limit<=0 或 None 的维视为未启用跳过
  （$ 第四维默认关=夹具 dollar_budget "0"；converge-check 联动：超支 used>limit 必 REJECT）。
  intent 已在账则并查份额叶（share 同律）；不在账=待铸 id，仅查根门。
  OP1（2026-10-14，02-opsec 建议表第一行「P0 八问⑥必填」）：goals.rate_limit
  未申报=REJECT rate-limit-unset、不可解析=REJECT rate-limit-bad（fail-closed，
  「预算必须是代码不是话术」）——申报后速率由 tanyin-guard gate_chain 滑窗
  执法位收口（enforce.rate_window 单源）。
rate：goals.rate_limit（如 600/10m）滑窗聚合 budget.tsv.requests_delta，窗（now-window, now]
  左开右闭；now=--now 或 budget.tsv 最大时间戳（无行=当前 UTC，可重放口径）；used>limit=REJECT
  exit 1。REJECT 落 timeline budgetctl-reject（链式续写）；PASS 只读不落账（查询面零副作用）。
  OP1：滑窗实现单源迁 ledger.enforce（rate_window/parse_rate/parse_ts——budgetctl
  查询面与 guard 执法面共用同一窗口，防两份漂移）；本文件输出/退出码字节不变。
退出码：0=OK 1=REJECT 2=用法/环境（批次纪律）。
"""
import json, os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger import core, query_cmds
from ledger.enforce import fmt, parse_rate, parse_ts, rate_window
from ledger.schemas import TABLES
from ledger.core import ensure_utf8_stdio

ensure_utf8_stdio()  # Windows 控制台默认 GBK：中文输出统一 UTF-8

TAB = chr(9)
DIMS = ("token", "requests", "hours", "dollars")


def usage():
    sys.stderr.write("用法: tanyin-budgetctl enforce --goal-dir D --intent-id <id> [--timestamp=T]"
                     " | rate --goal-dir D [--now=TS] [--timestamp=T]" + chr(10))
    return 2


# 批次 10 T5（P2#9）：timeline 铸造单源=ledger.timeline——本地复制退役，
# partial 绑定保调用点签名不变（actor=budgetctl, phase=P2）。
from functools import partial as _partial
from ledger.timeline import append_tl_locked as _append_tl_locked
append_tl = _partial(_append_tl_locked, actor="budgetctl", phase="P2")


# OP1（2026-10-14）：parse_ts/fmt/parse_rate 本地定义退役——单源=ledger.enforce
# （budgetctl 查询面与 guard 执法面共用，import 见上；tests/test_op1_enforce.py
# ::RateWindowUnit::test_single_source_no_local_copies 钉死不再回拷）。


def _reject(gd, ts, js, line):
    print(line)
    append_tl(gd, ts, "budgetctl-reject " + json.dumps(js, ensure_ascii=False, separators=(",", ":")))
    return 1


def cmd_enforce(gd, rest):
    kv = dict(a.partition("=")[::2] for a in rest if a.startswith("--"))
    iid = kv.get("--intent-id")
    if not iid:
        sys.stderr.write("enforce 缺 --intent-id" + chr(10))
        return 2
    # 批次 10 T5（P2#9）：EPOCH 缺省退役——--timestamp 必填。
    if not kv.get("--timestamp"):
        sys.stderr.write("enforce 须带 --timestamp=ISO8601（EPOCH 缺省已退役）" + chr(10))
        return 2
    ts = kv["--timestamp"]
    s = core.Session(gd)
    tree = query_cmds.budget_tree(s)
    if tree["goal"] is None:
        sys.stderr.write("环境问题: goals.tsv 无预算行" + chr(10))
        return 2
    # OP1（02-opsec 建议表第一行）：P0 八问⑥ rate_limit 必填——add-intent 派发门
    # 拒未申报速率上限的 goal；申报后由 tanyin-guard gate_chain 滑窗执法位收口。
    # 不可解析同拒（fail-closed）：申报了但读不懂=等同未申报。
    grows = s.rows("goals.tsv")
    rate_raw = (grows[0][TABLES["goals.tsv"].index("rate_limit")] if grows else "").strip()
    if not rate_raw:
        return _reject(gd, ts, {"mode": "enforce", "intent": iid, "check": "rate-limit-unset"},
                       "REJECT" + TAB + "rate-limit-unset" + TAB + "P0 八问⑥ goals.rate_limit 未申报"
                       + TAB + "（速率上限必填——gate_chain 执法位无从启用）")
    try:
        parse_rate(rate_raw)
    except ValueError:
        return _reject(gd, ts, {"mode": "enforce", "intent": iid, "check": "rate-limit-bad"},
                       "REJECT" + TAB + "rate-limit-bad" + TAB
                       + "goals.rate_limit 不可解析: " + rate_raw)
    for k in DIMS:  # 根门：goal 任一维余量耗尽
        lim = tree["goal"]["limit"][k]
        if lim is None or lim <= 0:
            continue
        used = tree["goal"]["used"][k]
        if used >= lim:
            return _reject(gd, ts, {"mode": "enforce", "intent": iid, "level": "goal", "dim": k,
                                    "used": used, "limit": lim},
                           "REJECT" + TAB + "budget-exhausted" + TAB + "goal" + TAB + k +
                           TAB + "used=" + fmt(used) + TAB + "limit=" + fmt(lim))
    leaf = next((i for i in tree["intents"] if i["id"] == iid), None)
    if leaf and leaf["share"]:  # 叶门：intent 份额（§8.7 intent 超份额→拒派）
        for k in DIMS:
            lim = leaf["share"][k]
            if lim is None or lim <= 0:
                continue
            used = leaf["used"][k]
            if used >= lim:
                return _reject(gd, ts, {"mode": "enforce", "intent": iid, "level": "intent", "dim": k,
                                        "used": used, "share": lim},
                               "REJECT" + TAB + "budget-exhausted" + TAB + "intent=" + iid +
                               TAB + k + TAB + "used=" + fmt(used) + TAB + "share=" + fmt(lim))
    gl = tree["goal"]["limit"]
    gu = tree["goal"]["used"]
    print("OK" + TAB + "enforce" + TAB + "intent=" + iid + TAB +
          "leaf=" + ("y" if leaf else "n") + TAB + "goal-left=" +
          ",".join("%s:%s" % (k, fmt(gl[k] - gu[k])) for k in ("token", "requests", "hours")))
    return 0


def cmd_rate(gd, rest):
    kv = dict(a.partition("=")[::2] for a in rest if a.startswith("--"))
    # 批次 10 T5（P2#9）：EPOCH 缺省退役——--timestamp 必填（REJECT 事件时间戳用）。
    if not kv.get("--timestamp"):
        sys.stderr.write("rate 须带 --timestamp=ISO8601（EPOCH 缺省已退役）" + chr(10))
        return 2
    s = core.Session(gd)
    if not s.rows("goals.tsv"):
        sys.stderr.write("环境问题: goals.tsv 缺失" + chr(10))
        return 2
    # OP1：滑窗单源=ledger.enforce.rate_window（guard 执法位同窗）；--now 缺省时
    # 窗口锚=账本最大流水时间（无行=当前 UTC，可重放口径）。四态映射保持既有
    # 输出/退出码字节不变（unset/bad*=env 2；over=REJECT 1；ok=OK 0）。
    now = parse_ts(kv["--now"]) if kv.get("--now") else None
    w = rate_window(s, now)
    if w["state"] == "unset":
        sys.stderr.write("环境问题: goals.rate_limit 未配置" + chr(10))
        return 2
    if w["state"] == "bad-limit":
        sys.stderr.write("环境问题: rate_limit 不可解析: " + w["raw"] + chr(10))
        return 2
    if w["state"] == "bad-stamp":
        sys.stderr.write("环境问题: budget.tsv 时间戳不可解析: %s" % w["err"] + chr(10))
        return 2
    if w["state"] == "over":
        return _reject(gd, kv["--timestamp"],
                       {"mode": "rate", "used": w["used"], "limit": w["limit"],
                        "window": w["window"]},
                       "REJECT" + TAB + "rate-limit" + TAB + "used=" + fmt(w["used"]) +
                       TAB + "limit=" + fmt(w["limit"]) + TAB + "window=" + str(w["window"]) + "s")
    print("OK" + TAB + "rate" + TAB + "limit=" + fmt(w["limit"]) + "/" + str(w["window"]) + "s" +
          TAB + "used=" + fmt(w["used"]) + TAB + "left=" + fmt(w["limit"] - w["used"]))
    return 0


def main(argv):
    if len(argv) < 4 or argv[2] != "--goal-dir":
        return usage()
    sub, gd, rest = argv[1], argv[3], argv[4:]
    if not os.path.isdir(gd):
        sys.stderr.write("环境问题: goal 目录不存在" + chr(10))
        return 2
    if sub == "enforce":
        return cmd_enforce(gd, rest)
    if sub == "rate":
        return cmd_rate(gd, rest)
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
