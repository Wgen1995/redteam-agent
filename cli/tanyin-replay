#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-replay（批次 4 T5）——POC 独立重放驱动（铁律 7 对外请求例外#1）。

replay：EV 卡片盲重放——解析 raw_request（HTTP 报文文本）→{{vault:cred-N}} 进程内解密替换
（真值不进 argv/不落盘，R2）→治理四门（SEC-2 舰 S4，v0.9.6）→host 过 scope 单源判定
（enforce.load_scope，出界=REJECT exit 1）→http.client 直发→matcher 评估→三态（R3）：
连接层失败=env-diff（REPAIRED 候选）/全中=reproduced（VERIFIED）/不中=not-reproduced
（REJECTED）/无 matcher=manual。
每请求落 timeline request: 事件（§4.10）；判定产物 replay/<EV-id>/<seq>.json 只增不覆盖。
matcher-test：离线评估（REPAIRED 修复循环）。退出码 0/1/2 对齐 Strix。

S4 治理四门（评审 02-security-enforcement.md S4：无窗口/无分类/无帽三裸奔收口）：
①授权窗——申报钟 --timestamp ∈ goals.tsv [valid_from, valid_until]（date-only 边界取
自然日：起日 00:00:00/止日 23:59:59；空界=无约束；坏界=fail-closed REJECT）；
②危险方法分类——非 GET 默认拒，--allow-method=POST（逗号多值）显式开；
③次数帽——单 EV 判定产物满 REPLAY_CAP（3）份即拒，无 CLI 豁免（防被俘战士自抬帽）；
④scope 单源——host_in_scope 吃 enforce.load_scope/scope_verdict（Tier1/2/3 同源），
自带第二套 amendment_of 跳行读法退役。

Ruling（计划骨架勘误，HANDOFF 批次4 T5 节）：未知 EV id=exit 2（用法问题可重跑），
骨架的 exit 1 与计划测试冲突，按接口口径「2=用法」取测试侧；占位符无真值=REJECT exit 1
（fail-closed，骨架此处会 TypeError）。"""
import http.client, json, os, re, socket, ssl, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger import cards, core, matchers, ua, vault  # noqa: E402
from ledger.enforce import load_scope, parse_ts, scope_verdict  # noqa: E402  SEC-2 S4 单源
from ledger.schemas import TABLES  # noqa: E402
from ledger.core import ensure_utf8_stdio  # noqa: E402

ensure_utf8_stdio()
TAB = chr(9)
PLACEHOLDER = re.compile(r"\{\{vault:cred-(\d+)\}\}")
REQUEST_LINE = re.compile(r"^([A-Z]+) (\S+) HTTP/(1\.[01])$")
SUGGEST = {"reproduced": "VERIFIED", "not-reproduced": "REJECTED", "env-diff": "REPAIRED"}
# SEC-2 舰 S4 ③次数帽：单 EV 判定产物上限（评审修正方向「3 次后转 manual」的机械面；
# 无 CLI 豁免——帽是执法件不是参数）。
REPLAY_CAP = 3


class _SecretMissing(Exception):
    pass


def usage():
    sys.stderr.write("用法: tanyin-replay replay --goal-dir D --id=<EV-id> [--scheme=http|https]"
                     " [--port=N] [--timeout=10] [--timestamp=T] [--ua=UA]"
                     " [--allow-method=POST[,DELETE]]（非 GET 默认拒，显式开）"
                     " | matcher-test --expected-file P --response-file F" + chr(10))
    return 2


def _kv(rest):
    """--key=value 与 --key value 双形态归一（计划测试用空格形态，骨架只认等号形态——
    以测试为准的 Ruling，见模块 docstring）。"""
    out, i = {}, 0
    while i < len(rest):
        a = rest[i]
        if a.startswith("--"):
            if "=" in a:
                k, _, v = a.partition("=")
                out[k] = v
                i += 1
            elif i + 1 < len(rest):
                out[a] = rest[i + 1]
                i += 2
            else:
                out[a] = ""
                i += 1
        else:
            i += 1
    return out


def parse_raw_request(text):
    lines = text.splitlines()
    m = REQUEST_LINE.match(lines[0].strip())
    if not m:
        raise ValueError("raw_request 首行非请求行: %r" % lines[0])
    headers, i = {}, 1
    for ln in lines[1:]:
        if not ln.strip():
            i += 1
            break
        k, _, v = ln.partition(":")
        headers[k.strip().lower()] = v.strip()
        i += 1
    body = "\r\n".join(lines[i:])
    return m.group(1), m.group(2), headers, body


# 批次 10 T5（P2#9）：timeline 铸造单源=ledger.timeline——本地复制退役，
# partial 绑定（actor=replay, phase=P4；ts 必填——EPOCH/墙钟缺省退役）。
from functools import partial as _partial
from ledger.timeline import append_tl_locked as _append_tl_locked
append_tl = _partial(_append_tl_locked, actor="replay", phase="P4")


def host_in_scope(gd, host):
    """scope 门链（R2；SEC-2 舰 S4 单源收口）：判定吃 enforce.load_scope/scope_verdict
    ——Tier1 guard/Tier2 hooks/Tier3 egress 同一读法（amendment 链同 matcher 后行覆盖
    先行），本文件自带的第二套 amendment_of 跳行实现退役（评审 S4：两套读法对同一
    scope.tsv 在「修订行改 matcher」场景判定分歧）。oob/界外一律非 in=拒。"""
    return scope_verdict(host, load_scope(core.Session(gd))) == "in"


def _bound_epoch(raw, end_of_day=False):
    """授权边界解析（S4 ①）：date-only（YYYY-MM-DD）→起日 00:00:00Z/止日 23:59:59Z
    （自然日语义——「授权至 9-30」含当日）；完整 ISO 直解；空=无界 None；
    非法=ValueError（调用方 fail-closed REJECT）。"""
    t = (raw or "").strip()
    if not t:
        return None
    if len(t) == 10 and t[4] == "-" and t[7] == "-":
        t += "T23:59:59Z" if end_of_day else "T00:00:00Z"
    return parse_ts(t)


def _goal_window(s):
    """goals.tsv 首行 (valid_from, valid_until) 原文；无行=("", "")。"""
    gi = TABLES["goals.tsv"].index
    grows = s.rows("goals.tsv")
    if not grows:
        return "", ""
    return grows[0][gi("valid_from")].strip(), grows[0][gi("valid_until")].strip()


def cmd_replay(gd, rest):
    kv = _kv(rest)
    # 批次 8 T5（M12）：链式多请求——--chain=EV-a,EV-b 有序序列；逐步复用单报文执法
    # （scope/占位符/同值性/matcher 全套）；env-diff 或 REJECT 即中止（fail-closed 有序性）。
    chain = kv.get("--chain", "")
    if chain:
        ids = [i.strip() for i in chain.split(",") if i.strip()]
        if not ids or any(not i.startswith("EV-") for i in ids):
            return usage()
        # 批次 10 T5（P2#9）：EPOCH 缺省退役——链式事件时间戳显式必填。
        ts = kv.get("--timestamp", "")
        if not ts:
            sys.stderr.write("chain 须带 --timestamp=ISO8601（EPOCH 缺省已退役）" + chr(10))
            return 2
        results, aborted = [], False
        for n, cid in enumerate(ids, 1):
            step_rest = ["--id=" + cid] + [a for a in rest
                                           if not a.startswith("--id=")
                                           and not a.startswith("--chain=")]
            rc = cmd_replay(gd, step_rest)
            verdict = ""
            d = os.path.join(gd, "replay", cid)
            if os.path.isdir(d):
                js = sorted((f for f in os.listdir(d) if f.endswith(".json")),
                            key=lambda f: int(f.split(".")[0]))
                if js:
                    verdict = json.load(open(os.path.join(d, js[-1]), encoding="utf-8")).get("verdict", "")
            results.append({"id": cid, "verdict": verdict, "rc": rc})
            if rc != 0 or verdict == "env-diff":
                aborted = True
                append_tl(gd, ts,
                          "replay-chain step=%d/%d id=%s verdict=%s aborted" % (n, len(ids), cid, verdict))
                break
            append_tl(gd, ts,
                      "replay-chain step=%d/%d id=%s verdict=%s" % (n, len(ids), cid, verdict))
        print(json.dumps({"chain": results, "aborted": aborted}, ensure_ascii=False, sort_keys=True))
        return 1 if aborted else 0
    rid = kv.get("--id", "")
    if not rid or not rid.startswith("EV-"):
        return usage()
    s = core.Session(gd)
    row = next((r for r in s.rows("E-index.tsv") if r[0] == rid), None)
    if row is None:
        sys.stderr.write("用法问题: --id 引用闭合失败（E-index 无此行，可重跑）: %s\n" % rid)
        return 2
    card_path = os.path.join(gd, row[TABLES["E-index.tsv"].index("card_path")])
    try:
        card = cards.parse_ev_card(card_path)
    except cards.CardError as e:
        sys.stderr.write("REJECT\treplay\t卡片不可解析: %s\n" % e)
        return 1
    except OSError as e:
        # 批次 8 T10b（M1 尾）：文件缺/不可读=环境域 exit 2（非门禁失败）
        sys.stderr.write("环境问题\treplay\t卡片文件不可读: %s\n" % e)
        return 2
    errs = cards.check_consistency(card, row)
    if errs:
        sys.stderr.write("REJECT\treplay\t卡片与 E-index 同值性失败（§4.11）: %s\n" % "; ".join(errs))
        return 1
    raw = card.get("raw_request", "") or ""
    if not raw.strip():
        sys.stderr.write("REJECT\treplay\traw_request 空——无可重放请求\n")
        return 1
    try:
        method, path, headers, body = parse_raw_request(raw)
    except ValueError as e:
        sys.stderr.write("REJECT\treplay\traw_request 不可解析: %s\n" % e)
        return 1
    scheme = kv.get("--scheme", "http")
    if scheme not in ("http", "https"):
        return usage()
    try:
        timeout = float(kv.get("--timeout", "10"))
        port_arg = kv.get("--port", "")
        port_override = int(port_arg) if port_arg else None
    except ValueError:
        return usage()
    host = headers.get("host", "")
    if not host:
        sys.stderr.write("REJECT\treplay\traw_request 缺 Host 头\n")
        return 1
    if ":" in host:
        host, _, port_s = host.partition(":")
        port = int(port_s) if port_s.isdigit() else (443 if scheme == "https" else 80)
    else:
        port = port_override or (443 if scheme == "https" else 80)
    # 批次 10 T5（P2#9）：EPOCH 缺省退役——--timestamp 必填（replay/chain 两路同律）。
    ts = kv.get("--timestamp", "")
    if not ts:
        sys.stderr.write("replay 须带 --timestamp=ISO8601（EPOCH 缺省已退役）" + chr(10))
        return 2
    # ---- SEC-2 舰 S4 治理四门（v0.9.6，评审 S4「无窗/无分类/无帽」收口）----
    # ①授权时间窗：申报钟 ts ∈ [valid_from, valid_until]；坏界 fail-closed。
    gf, gu = _goal_window(s)
    try:
        t_e = parse_ts(ts)
        f_e = _bound_epoch(gf)
        u_e = _bound_epoch(gu, end_of_day=True)
    except ValueError:
        sys.stderr.write("REJECT\treplay\t授权窗口边界不可解析（fail-closed）: valid_from=%s valid_until=%s\n"
                         % (gf or "-", gu or "-"))
        append_tl(gd, ts, "request: %s%s via=replay REJECT=authz-window bad-bound" % (host, path))
        return 1
    if (f_e is not None and t_e < f_e) or (u_e is not None and t_e > u_e):
        why = "未开始" if (f_e is not None and t_e < f_e) else "已过期"
        sys.stderr.write("REJECT\treplay\t授权窗口外（%s）: valid_from=%s valid_until=%s\n"
                         % (why, gf or "-", gu or "-"))
        append_tl(gd, ts, "request: %s%s via=replay REJECT=authz-window %s valid=%s..%s"
                  % (host, path, why, gf or "-", gu or "-"))
        return 1
    # ②危险方法分类：非 GET 默认拒（二次伤害面：POST/PUT/DELETE 重放=重复脏数据/
    # 重复触发 SIEM）；--allow-method=M 逗号多值显式开。
    allowed = {"GET"} | {m.strip().upper() for m in kv.get("--allow-method", "").split(",") if m.strip()}
    if method.upper() not in allowed:
        sys.stderr.write("REJECT\treplay\t危险方法默认拒（method=%s；非 GET 须 --allow-method=%s 显式开）\n"
                         % (method.upper(), method.upper()))
        append_tl(gd, ts, "request: %s%s via=replay REJECT=method method=%s" % (host, path, method.upper()))
        return 1
    # ③次数帽：单 EV 判定产物满 REPLAY_CAP 份即拒（DoS 面：chain+循环无节流的机械上限；
    # 无 CLI 豁免）。拒行不落产物——帽计的是实际发包次数。
    _rd = os.path.join(gd, "replay", rid)
    _used = len([x for x in os.listdir(_rd) if x.endswith(".json")]) if os.path.isdir(_rd) else 0
    if _used >= REPLAY_CAP:
        sys.stderr.write("REJECT\treplay\t单 EV 重放次数帽（used=%d cap=%d）——转 manual 判定或另起 EV\n"
                         % (_used, REPLAY_CAP))
        append_tl(gd, ts, "request: %s%s via=replay REJECT=replay-cap used=%d cap=%d"
                  % (host, path, _used, REPLAY_CAP))
        return 1
    if not host_in_scope(gd, host):
        append_tl(gd, ts, "request: %s%s via=replay REJECT=out-of-scope" % (host, path))
        sys.stderr.write("REJECT\treplay\t目标 host 界外（scope include/exclude 判定）: %s\n" % host)
        return 1

    # 占位符进程内回注（四关卡①：真值不进 argv/不落盘；缺真值=fail-closed REJECT）
    def sub(mo):
        sec = vault.secret(gd, mo.group(1))
        if sec is None:
            raise _SecretMissing(mo.group(0))
        return sec

    try:
        headers = {k: PLACEHOLDER.sub(sub, v) for k, v in headers.items()}
        body = PLACEHOLDER.sub(sub, body)
    except _SecretMissing as e:
        sys.stderr.write("REJECT\treplay\t占位符无真值（vault 缺 key/缺条目/缺密位）: %s\n" % e)
        return 1
    # OP2（02-opsec 审计#1「UA 自报家门」）：禁自名 UA——卡片自名/缺 UA 头
    # 一律中性默认（TANYIN_UA env 可配），--ua 显式覆盖一切，第三方 UA 保真
    # 透传（重放保真不归因）。出站最后一道整形，卡片原文不回写。
    ua_out = ua.resolve_ua(headers.get("user-agent", ""), kv.get("--ua", ""),
                           os.environ.get(ua.ENV_UA, ""))
    if ua_out is not None:
        headers["user-agent"] = ua_out
    append_tl(gd, ts, "request: %s%s via=replay" % (host, path))
    try:
        conn_cls = http.client.HTTPSConnection if scheme == "https" else http.client.HTTPConnection
        conn = conn_cls(host, port, timeout=timeout)
        conn.request(method, path, body=body or None, headers=dict(headers))
        resp = conn.getresponse()
        status, rheaders, rbody = resp.status, dict(resp.getheaders()), resp.read().decode("utf-8", "replace")
        conn.close()
    except (socket.error, ssl.SSLError, OSError, http.client.HTTPException) as e:
        verdict, out = "env-diff", {"matched": None, "results": [], "extracted": {},
                                    "detail": "%s: %s" % (type(e).__name__, e)}
    else:
        try:
            ev = matchers.evaluate(card.get("expected") or {}, status,
                                   {k.lower(): v for k, v in rheaders.items()}, rbody)
        except matchers.MatcherError as e:
            sys.stderr.write("REJECT\treplay\t卡片 expected 不在 matcher 子集（R1 fail-closed）: %s\n" % e)
            return 1
        verdict = {True: "reproduced", False: "not-reproduced", None: "manual"}[ev["matched"]]
        out = {"matched": ev["matched"], "status": status, "results": ev["results"],
               "extracted": ev["extracted"]}
    note = {"env-diff": "环境差异（连接层失败）——修复 EV 卡片 preconditions 网络位置/前置后重放"}.get(verdict, "")
    suggest = ("tanyin-ledger set-replay-state --goal-dir %s --id=%s --state=%s%s"
               % (gd, rid, SUGGEST.get(verdict, "VERIFIED"),
                  (" --note=" + note) if note else ""))
    result = {"id": rid, "verdict": verdict}
    result.update(out)
    result["suggest"] = suggest if verdict != "manual" else "无 matcher——人工判定后落态"
    d = os.path.join(gd, "replay", rid)
    os.makedirs(d, exist_ok=True)
    seq = len([x for x in os.listdir(d) if x.endswith(".json")]) + 1
    with open(os.path.join(d, "%d.json" % seq), "w", encoding="utf-8", newline="\n") as f:
        json.dump(result, f, ensure_ascii=False, sort_keys=True)
    append_tl(gd, ts, "replay-probe %s verdict=%s" % (rid, verdict))
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_matcher_test(rest):
    kv = _kv(rest)
    if not kv.get("--expected-file") or not kv.get("--response-file"):
        return usage()
    expected = json.load(open(kv["--expected-file"], encoding="utf-8"))
    text = open(kv["--response-file"], encoding="utf-8", errors="replace").read()
    head, _, body = text.partition("\r\n\r\n")
    parts = head.split(" ")
    status = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0
    try:
        r = matchers.evaluate(expected, status, {}, body)
    except matchers.MatcherError as e:
        sys.stderr.write("REJECT\tmatcher-test\texpected 不在 matcher 子集: %s\n" % e)
        return 1
    print(json.dumps(r, ensure_ascii=False, sort_keys=True))
    return 0


def main(argv):
    if len(argv) < 2:
        return usage()
    sub, rest = argv[1], argv[2:]
    if sub == "replay":
        gd = _kv(rest).get("--goal-dir", "")
        if not gd:
            return usage()
        if not os.path.isdir(gd):
            sys.stderr.write("环境问题: goal 目录不存在 " + gd + chr(10))
            return 2
        return cmd_replay(gd, rest)
    if sub == "matcher-test":
        return cmd_matcher_test(rest)
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
