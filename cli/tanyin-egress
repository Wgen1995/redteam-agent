#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tanyin-egress（批次 2 T3）——Tier 3 出口编译器：scope.tsv 生效链 -> egress.acl 四成分。
compile：include 展开 allow / exclude 展开 deny / oob 行白名单 / 基础设施白名单（内置清单【推导】可配置）。
     确定性：排序稳定、无时间戳；文件头带 source 指纹 + 自指纹（两遍法）。
verify：重编译与现存 egress.acl 字节比对（scope 修订后 drift 检测，exit 1）。
dry-run：打印代理启动命令模板（实代理=批次 6 靶场，诚实披露）。
serve：Tier3 代理本体（批次 6 T10；裁决 H）——HTTP 明文转发+CONNECT 隧道按目标
     主机名 ACL 判定（TLS 不解密无中间人）+DNS pin 比对+OOB 落账+canary 触碰告警。
"""
import hashlib, os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledger import core
from ledger import enforce
from ledger import egress_proxy
from ledger.core import ensure_utf8_stdio

ensure_utf8_stdio()  # Windows 控制台默认 GBK：中文输出统一 UTF-8

INFRA = ["api.github.com", "crt.sh", "nvd.nist.gov", "osv.dev", "pypi.org", "registry.npmjs.org"]
EPOCH = "1970-01-01T00:00:00Z"   # compile 事件时间戳（无 --timestamp 参数；canary recon-recall 同款确定性纪律）


def append_tl(gd, event):
    """timeline 追加一行链式事件（actor=egress；canary append_tl 同律的本地实现）。
    批4 T13：trigger-audit ③（scope-amended→egress-compile 闭环）的事件载体。
    批次 7 评审收尾 I-3：goal 锁包「读表→算链→写回」全程（filelock 单源，
    复用 registry._locked 锁形）——并发 append 不再 lost-update/撕裂。"""
    from ledger.filelock import goal_lock
    with goal_lock(gd):
        s = core.Session(gd)
        rows = s.rows("timeline.tsv")
        hi = core.TABLES["timeline.tsv"].index("hash")
        prev = rows[-1][hi] if rows else core.GENESIS
        wo = [EPOCH, "egress", "", event, "", prev, "2"]
        rows.append([EPOCH, "egress", "", event, "", prev, core.row_hash(prev, wo), "2"])
        core.write_tsv(os.path.join(gd, "timeline.tsv"), rows)


def usage():
    sys.stderr.write("用法: tanyin-egress compile|verify|dry-run --goal-dir D [--out P]" + chr(10))
    return 2


def _recon_decoys(gd):
    """侦察诱饵值列（批次 7 T11）：canary/recon-decoys.tsv 列[1]——与
    phases_engine denominator-ready ④同口径（type/value 两列取值列）；文件缺=空集
    （compile 不因诱饵未部署而失败）。排序去重=compile 确定性纪律。"""
    p = os.path.join(gd, "canary", "recon-decoys.tsv")
    vals = []
    if os.path.isfile(p):
        for ln in open(p, encoding="utf-8").read().splitlines():
            if ln.strip():
                parts = ln.split(chr(9))
                if len(parts) > 1 and parts[1].strip():
                    vals.append(parts[1].strip())
    return sorted(set(vals))


def build_acl(gd):
    # 洞 1 修复：scope 解析改调 enforce.load_scope 同一函数——账本=执法策略单一
    # 事实源（amendment 链后行覆盖先行），消除 Tier1/Tier2/Tier3 两层解释矛盾。
    scope = enforce.load_scope(core.Session(gd))
    inc = sorted(scope["include"])
    exc = sorted(scope["exclude"])
    oob = sorted(scope["oob"])
    src_sha = hashlib.sha256(open(os.path.join(gd, "scope.tsv"), "rb").read()).hexdigest()[:16]
    L = ["# tanyin egress.acl v2 (deny-by-default)"]
    L.append("# source: scope.tsv sha16=" + src_sha)
    L.append("# self: PENDING")
    L.append("")
    L.append("[acl]")
    L.append("default deny")
    for m in exc:
        L.append("deny " + m)
    for m in inc:
        L.append("allow " + m)
    L.append("")
    L.append("[dns-pinning]")
    for m in inc:
        if "/" not in m:
            L.append("pin " + m)
    L.append("")
    L.append("[oob]")
    for m in oob:
        L.append("allow-oob " + m)
    L.append("")
    # [canary] 段（批次 7 T11，High：两声明面默认失效收口）=侦察诱饵值列
    # （scope kind=canary 行在 add-scope 四值枚举冻结下不可达，见台账 R-T11-2）。
    L.append("[canary]")
    for m in _recon_decoys(gd):
        L.append("canary " + m)
    L.append("")
    L.append("[infra]")
    for m in INFRA:
        L.append("allow-infra " + m)
    body = chr(10).join(L[3:])
    self_sha = hashlib.sha256(body.encode("utf-8")).hexdigest()[:16]
    L[2] = "# self: sha16=" + self_sha
    return chr(10).join(L) + chr(10)


def cmd_compile(gd, out):
    text = build_acl(gd)
    p = out or os.path.join(gd, "egress.acl")
    # newline="\n"：自指纹按 LF 主体计算，Windows 不得译成 CRLF（字节精确红线）
    with open(p, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    n = len(text.splitlines())
    print("OK egress compile -> " + p + " (" + str(n) + " lines)")
    # 批4 T13：compile 落账 egress-compile 事件（幂等重编译=事件只记不判重；相对路径防绝对路径漂移）
    append_tl(gd, "egress-compile acl=%s lines=%d" % (os.path.relpath(p, gd), n))
    return 0


def cmd_verify(gd):
    p = os.path.join(gd, "egress.acl")
    if not os.path.exists(p):
        print("REJECT egress verify 无现存 egress.acl（先 compile）")
        return 1
    want = build_acl(gd)
    have = open(p, encoding="utf-8").read()
    if want == have:
        print("OK egress verify 一致（scope 无漂移）")
        return 0
    print("REJECT egress verify 漂移：scope.tsv 已修订，须 recompile+canary 复测（定稿 §7 闭环）")
    return 1


def cmd_dryrun():
    print("# 代理启动模板（dry-run；实代理验证=批次 6 靶场）")
    print("# 成分: [acl]=L3 过滤规则 [dns-pinning]=解析器 pin 表 [oob]=带外白名单 [infra]=基础设施直连白名单")
    print("tanyin-proxy --acl egress.acl --mode deny-by-default --log goal_dir/timeline 事件=egress-deny")
    return 0


def cmd_serve(rest):
    """serve 子命令（批次 6 T10；裁决 H）：Tier3 代理本体前台常驻（无守护进程纪律
    合规——操作者显式起服、Ctrl-C 优雅退出）。退出码 0=正常退出/2=用法或 ACL 不合法。"""
    import argparse
    ap = argparse.ArgumentParser(prog="tanyin-egress serve")
    ap.add_argument("--acl", required=True, help="egress.acl 路径（compile 产物）")
    ap.add_argument("--port", type=int, default=8080, help="监听端口（127.0.0.1）")
    ap.add_argument("--egress-log", default=None,
                    help="egress-log.jsonl 路径（唯一运行时工件；代理绝不写 13 表）")
    ap.add_argument("--timestamp", default=None,
                    help="显式 ISO8601（log 行 ts；缺省=UTC 真墙钟——批次 7 T11；测试显式注入固定 now=确定性通道）")
    a = ap.parse_args(rest)
    try:
        # now=None 缺省=UTC 真墙钟（批次 7 T11，Medium 收口：egress now 常量）
        httpd = egress_proxy.serve(a.acl, a.port, egress_log=a.egress_log,
                                   now=a.timestamp)
    except ValueError as e:
        sys.stderr.write("ACL 不合法（fail-closed）: %s\n" % e)
        return 2
    except OSError as e:
        sys.stderr.write("环境问题: %s\n" % e)
        return 2
    print("egress-proxy listening 127.0.0.1:%d acl=%s" % (httpd.server_address[1], a.acl))
    print("# TLS 限制披露：CONNECT 按 CONNECT 目标主机名判定，不解析 TLS 内容（无中间人）")
    print("# G-41 性能披露：并发/吞吐上限未测——机械执法组件，性能非首批目标")
    sys.stdout.flush()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    return 0


def main(argv):
    # __main__ 传全量 sys.argv（compile/verify/dry-run 既有 argv[1] 取子命令形态同源）
    if len(argv) > 1 and argv[1] == "serve":
        return cmd_serve(argv[2:])
    if len(argv) < 4 or argv[2] != "--goal-dir":
        return usage()
    sub, gd = argv[1], argv[3]
    if not os.path.isdir(gd):
        sys.stderr.write("环境问题: goal 目录不存在" + chr(10))
        return 2
    out = None
    for a in argv[4:]:
        if a.startswith("--out="):
            out = a.split("=", 1)[1]
    if sub == "compile":
        return cmd_compile(gd, out)
    if sub == "verify":
        return cmd_verify(gd)
    if sub == "dry-run":
        return cmd_dryrun()
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv))